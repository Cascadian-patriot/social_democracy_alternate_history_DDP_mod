title: Status
new-page: true
is-special: true
on-arrival: {!
if (Q.unemployed) {
    Q.unemployed_2 = Q.unemployed.toFixed(1);
}
if (Q.inflation) {
    Q.inflation_2 = Q.inflation.toFixed(1);
}
Q.economic_growth_2 = '0';
if (Q.economic_growth) {
    Q.economic_growth_2 = Q.economic_growth.toFixed(1);
}
!}

= Status

Week [+ weeks +], [+ month : month +] [+ year +] 

Resources available: [+ resources +]

DDP position: [? if ddp_toleration : toleration ?][? if ddp_in_government : in government - ?][? if ddp_toleration == 0 and ddp_in_government == 0 and ddp_caretaker == 0 : opposition ?][? if ddp_caretaker : caretaker government ?][? if in_weimar_coalition and ddp_in_government: Weimar Coalition ?][? if in_grand_coalition and ddp_in_government: Grand Coalition ?][? if in_ddp_majority and ddp_in_government: DDP majority ?][? if in_minority_government and ddp_in_government: minority government ?][? if in_emergency_government and ddp_in_government: emergency government ?]

[? if ddp_in_government and not in_ddp_majority : Coalition dissent: [+ coalition_dissent : coalition_dissent +] ?]

Internal dissent: [+ dissent_percent : dissent +]

= Government

President: [? if president_party == "SPD": <span style="color: var(--spd-colour);">[+ president +]</span>?][? if president_party == "USPD": <span style="color: var(--uspd-colour);">[+ president +]</span>?][? if president_party == "I":<span style="color: var(--i-colour);">[+ president +]</span>?][? if president_party == "SAPD": <span style="color: var(--sapd-colour);">[+ president +]</span>?][? if president_party == "DAP": <span style="color: var(--dap-colour);">[+ president +]</span>?][? if president_party == "Z": <span style="color: var(--z-colour);">[+ president +]</span>?][? if president_party == "NSDAP": <span style="color: var(--nsdap-colour);">[+ president +]</span>?][? if president_party == "KPD": <span style="color: var(--kpd-colour);">[+ president +]</span>?][? if president_party == "DNVP": <span style="color: var(--dnvp-colour);">[+ president +]</span>?] ([? if president_party == "Z":<span style="color: var(--z-colour);">**[+ z_party_name +]**</span>?][? if president_party == "SPD":<span style="color: var(--spd-colour);">**SPD**</span>?][? if president_party == "KPD":<span style="color: var(--kpd-colour);">**KPD**</span>?][? if president_party == "SAPD":<span style="color: var(--sapd-colour);">**SAPD**</span>?][? if president_party == "DNVP": <span style="color: var(--dnvp-colour);">**DNVP**</span>?][? if president_party == "NSDAP":<span style="color: var(--nsdap-colour);">**NSDAP**</span>?][? if president_party == "I":<span style="color: var(--i-colour);">**I**</span>?][? if president_party == "USPD": <span style="color: var(--uspd-colour);">**USPD**</span>?][? if president_party == "DAP":DAP?][? if chancellor_party == "I":<span style="color: var(--i-colour);">**I**</span>?])

Chancellor: [? if chancellor_party == "SPD": <span style="color: var(--spd-colour);">[+ chancellor +]</span>?][? if chancellor_party == "USPD": <span style="color: var(--uspd-colour);">[+ chancellor +]</span>?][? if chancellor_party == "SAPD": <span style="color: var(--sapd-colour);">[+ chancellor +]</span>?][? if chancellor_party == "Z": <span style="color: var(--z-colour);">[+ chancellor +]</span>?][? if chancellor_party == "DAP": <span style="color: var(--dap-colour);">[+ chancellor +]</span>?][? if chancellor_party == "NSDAP": <span style="color: var(--nsdap-colour);">[+ chancellor +]</span>?][? if chancellor_party == "KPD": <span style="color: var(--kpd-colour);">[+ chancellor +]</span>?][? if chancellor_party == "I":<span style="color: var(--i-colour);">[+ chancellor +]</span>?][? if chancellor_party == "DNVP": <span style="color: var(--dnvp-colour);">[+ chancellor +]</span>?] ([? if chancellor_party == "Z":<span style="color: var(--z-colour);">**[+ z_party_name +]**</span>?][? if chancellor_party == "SPD":<span style="color: var(--spd-colour);">**SPD**</span>?][? if chancellor_party == "KPD":<span style="color: var(--kpd-colour);">**KPD**</span>?][? if chancellor_party == "SAPD":<span style="color: var(--sapd-colour);">**SAPD**</span>?][? if chancellor_party == "DNVP": <span style="color: var(--dnvp-colour);">**DNVP**</span>?][? if chancellor_party == "NSDAP":<span style="color: var(--nsdap-colour);">**NSDAP**</span>?][? if chancellor_party == "I":<span style="color: var(--i-colour);">**I**</span>?][? if chancellor_party == "USPD": <span style="color: var(--uspd-colour);">**USPD**</span>?][? if chancellor_party == "DAP":DAP?])


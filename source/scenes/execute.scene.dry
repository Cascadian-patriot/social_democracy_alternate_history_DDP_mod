<div style="max-width: 560px; margin: 16px auto; line-height: 1.5; font-size: 1.2em; background: var(--surface-cabinet-paper); color: var(--text-on-paper); border: 3px solid var(--border-interactive); padding: 16px 20px; box-shadow: 2px 2px 8px var(--shadow-color);"><div style="display: flex; justify-content: space-between; align-items: flex-start; padding: 6px 0px;"><div><div style="font-weight: bold;">Chancellor</div><div style="font-style: italic; font-size: 0.85em;">Reichskanzler</div></div><div style="text-align: right;"><div style="font-weight: bold;">Luther</div><div>(<span data-rich-color-role="text-muted" style="font-weight: bold;">I</span>)</div></div></div><div style="display: flex; justify-content: space-between; align-items: flex-start; padding: 6px 0px;"><div><div style="font-weight: bold;">Foreign Affairs</div><div style="font-style: italic; font-size: 0.85em;">Auswärtiges</div></div><div style="text-align: right;"><div style="font-weight: bold;">Streseman</div><div>(<span data-rich-color-role="party-dvp" style="font-weight: bold;">DVP</span>)</div></div></div><div style="display: flex; justify-content: space-between; align-items: flex-start; padding: 6px 0px;"><div><div style="font-weight: bold;">Interior</div><div style="font-style: italic; font-size: 0.85em;">Inneres</div></div><div style="text-align: right;"><div style="font-weight: bold;">Külz</div><div>(<span data-rich-color-role="party-ddp" style="font-weight: bold;">DDP</span>)</div></div></div><div style="display: flex; justify-content: space-between; align-items: flex-start; padding: 6px 0px;"><div><div style="font-weight: bold;">Finance</div><div style="font-style: italic; font-size: 0.85em;">Finanzen</div></div><div style="text-align: right;"><div style="font-weight: bold;">Reinhold</div><div>(<span data-rich-color-role="party-ddp" style="font-weight: bold;">DDP</span>)</div></div></div><div style="display: flex; justify-content: space-between; align-items: flex-start; padding: 6px 0px;"><div><div style="font-weight: bold;">Economic Affairs</div><div style="font-style: italic; font-size: 0.85em;">Wirtschaft</div></div><div style="text-align: right;"><div style="font-weight: bold;">Krohne</div><div>(<span data-rich-color-role="party-dvp" style="font-weight: bold;">DVP</span>)</div></div></div><div style="display: flex; justify-content: space-between; align-items: flex-start; padding: 6px 0px;"><div><div style="font-weight: bold;">Labor</div><div style="font-style: italic; font-size: 0.85em;">Arbeit</div></div><div style="text-align: right;"><div style="font-weight: bold;">Brauns</div><div>(<span data-rich-color-role="party-z" style="font-weight: bold;">Z</span>)</div></div></div><div style="display: flex; justify-content: space-between; align-items: flex-start; padding: 6px 0px;"><div><div style="font-weight: bold;">Justice</div><div style="font-style: italic; font-size: 0.85em;">Justiz</div></div><div style="text-align: right;"><div style="font-weight: bold;">Luther</div><div>(<span data-rich-color-role="text-muted" style="font-weight: bold;">I</span>)</div></div></div><div style="display: flex; justify-content: space-between; align-items: flex-start; padding: 6px 0px;"><div><div style="font-weight: bold;">Agriculture</div><div style="font-style: italic; font-size: 0.85em;">Landwirtschaft</div></div><div style="text-align: right;"><div style="font-weight: bold;">Kanitz</div><div>(<span data-rich-color-role="text-muted" style="font-weight: bold;">I</span>)</div></div></div><div style="display: flex; justify-content: space-between; align-items: flex-start; padding: 6px 0px;"><div><div style="font-weight: bold;">Reichswehr</div><div style="font-style: italic; font-size: 0.85em;">Reichswehr</div></div><div style="text-align: right;"><div style="font-weight: bold;">Gessler</div><div>(<span data-rich-color-role="party-ddp" style="font-weight: bold;">DDP</span>)</div></div></div></div>


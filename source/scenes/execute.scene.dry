<div id="exec_overview"><div class="exec-portraits-row"><div class="exec-portrait-card"><div class="exec-portrait-frame"><img src="[+ img_president +]" alt="President" decoding="async" loading="eager" fetchpriority="high"></div><div class="exec-portrait-role"><span style="color: var(--text-colour);">Reichspräsident</span></div><div class="exec-portrait-name">[? if president_party == "SPD": <span style="color: var(--spd-colour);">[+ president +]</span>?][? if president_party == "USPD": <span style="color: var(--uspd-colour);">[+ president +]</span>?][? if president_party == "I":<span style="color: var(--i-colour);">[+ president +]</span>?][? if president_party == "SAPD": <span style="color: var(--sapd-colour);">[+ president +]</span>?][? if president_party == "DAP": <span style="color: var(--dap-colour);">[+ president +]</span>?][? if president_party == "Z": <span style="color: var(--z-colour);">[+ president +]</span>?][? if president_party == "NSDAP": <span style="color: var(--nsdap-colour);">[+ president +]</span>?][? if president_party == "KPD": <span style="color: var(--kpd-colour);">[+ president +]</span>?][? if president_party == "DNVP": <span style="color: var(--dnvp-colour);">[+ president +]</span>?]</div><div class="exec-portrait-party">([? if president_party == "Z":<span style="color: var(--z-colour);">**[+ z_party_name +]**</span>?][? if president_party == "SPD":<span style="color: var(--spd-colour);">**SPD**</span>?][? if president_party == "KPD":<span style="color: var(--kpd-colour);">**KPD**</span>?][? if president_party == "SAPD":<span style="color: var(--sapd-colour);">**SAPD**</span>?][? if president_party == "DNVP": <span style="color: var(--dnvp-colour);">**DNVP**</span>?][? if president_party == "NSDAP":<span style="color: var(--nsdap-colour);">**NSDAP**</span>?][? if president_party == "I":<span style="color: var(--i-colour);">**I**</span>?][? if president_party == "USPD": <span style="color: var(--uspd-colour);">**USPD**</span>?][? if president_party == "DAP":DAP?][? if chancellor_party == "I":<span style="color: var(--i-colour);">**I**</span>?])</div></div><div class="exec-portrait-card"><div class="exec-portrait-frame"><img src="[+ img_chancellor +]" alt="Chancellor" decoding="async" loading="eager" fetchpriority="high"></div><div class="exec-portrait-role"><span style="color: var(--text-colour);">[+ chancellor_position_name +]</span></div><div class="exec-portrait-name">[? if chancellor_party == "SPD": <span style="color: var(--spd-colour);">[+ chancellor +]</span>?][? if chancellor_party == "USPD": <span style="color: var(--uspd-colour);">[+ chancellor +]</span>?][? if chancellor_party == "SAPD": <span style="color: var(--sapd-colour);">[+ chancellor +]</span>?][? if chancellor_party == "Z": <span style="color: var(--z-colour);">[+ chancellor +]</span>?][? if chancellor_party == "DAP": <span style="color: var(--dap-colour);">[+ chancellor +]</span>?][? if chancellor_party == "NSDAP": <span style="color: var(--nsdap-colour);">[+ chancellor +]</span>?][? if chancellor_party == "KPD": <span style="color: var(--kpd-colour);">[+ chancellor +]</span>?][? if chancellor_party == "I":<span style="color: var(--i-colour);">[+ chancellor +]</span>?][? if chancellor_party == "DNVP": <span style="color: var(--dnvp-colour);">[+ chancellor +]</span>?]</div><div class="exec-portrait-party">([? if chancellor_party == "Z":<span style="color: var(--z-colour);">**[+ z_party_name +]**</span>?][? if chancellor_party == "SPD":<span style="color: var(--spd-colour);">**SPD**</span>?][? if chancellor_party == "KPD":<span style="color: var(--kpd-colour);">**KPD**</span>?][? if chancellor_party == "SAPD":<span style="color: var(--sapd-colour);">**SAPD**</span>?][? if chancellor_party == "DNVP": <span style="color: var(--dnvp-colour);">**DNVP**</span>?][? if chancellor_party == "NSDAP":<span style="color: var(--nsdap-colour);">**NSDAP**</span>?][? if chancellor_party == "I":<span style="color: var(--i-colour);">**I**</span>?][? if chancellor_party == "USPD": <span style="color: var(--uspd-colour);">**USPD**</span>?][? if chancellor_party == "DAP":DAP?])</div></div></div>


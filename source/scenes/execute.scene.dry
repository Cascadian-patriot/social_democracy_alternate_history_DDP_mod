title: Executive Affairs
new-page: true

= Executive Affairs

<div id="exec_overview"><div class="exec-portraits-row"><div class="exec-portrait-card"><div class="exec-portrait-frame"><img src="[+ img_president +]" alt="President" decoding="async" loading="eager" fetchpriority="high"></div><div class="exec-portrait-role"><span style="color: var(--text-color);">Reichspräsident</span></div><div class="exec-portrait-name">[? if president_party == "SPD": <span style="color: var(--spd-colour);">[+ president +]</span>?][? if president_party == "USPD": <span style="color: var(--uspd-colour);">[+ president +]</span>?][? if president_party == "I":<span style="color: var(--i-colour);">[+ president +]</span>?][? if president_party == "SAPD": <span style="color: var(--sapd-colour);">[+ president +]</span>?][? if president_party == "DAP": <span style="color: var(--dap-colour);">[+ president +]</span>?][? if president_party == "Z": <span style="color: var(--z-colour);">[+ president +]</span>?][? if president_party == "NSDAP": <span style="color: var(--nsdap-colour);">[+ president +]</span>?][? if president_party == "KPD": <span style="color: var(--kpd-colour);">[+ president +]</span>?][? if president_party == "DNVP": <span style="color: var(--dnvp-colour);">[+ president +]</span>?]</div><div class="exec-portrait-party"><span style="color: var(--text-color);">(</span>[? if president_party == "Z":<span style="color: var(--z-colour);">**Z**</span>?][? if president_party == "SPD":<span style="color: var(--spd-colour);">**SPD**</span>?][? if president_party == "KPD":<span style="color: var(--kpd-colour);">**KPD**</span>?][? if president_party == "SAPD":<span style="color: var(--sapd-colour);">**SAPD**</span>?][? if president_party == "DNVP": <span style="color: var(--dnvp-colour);">**DNVP**</span>?][? if president_party == "NSDAP":<span style="color: var(--nsdap-colour);">**NSDAP**</span>?][? if president_party == "I":<span style="color: var(--i-colour);">**I**</span>?][? if president_party == "USPD": <span style="color: var(--uspd-colour);">**USPD**</span>?][? if president_party == "DAP":DAP?][? if chancellor_party == "I":<span style="color: var(--i-colour);">**I**</span>?]<span style="color: var(--text-color);">)</span></div></div><div class="exec-portrait-card"><div class="exec-portrait-frame"><img src="[+ img_chancellor +]" alt="Chancellor" decoding="async" loading="eager" fetchpriority="high"></div><div class="exec-portrait-role"><span style="color: var(--text-color);">[+ chancellor_position_name +]</span></div><div class="exec-portrait-name">[? if chancellor_party == "SPD": <span style="color: var(--spd-colour);">[+ chancellor +]</span>?][? if chancellor_party == "USPD": <span style="color: var(--uspd-colour);">[+ chancellor +]</span>?][? if chancellor_party == "SAPD": <span style="color: var(--sapd-colour);">[+ chancellor +]</span>?][? if chancellor_party == "Z": <span style="color: var(--z-colour);">[+ chancellor +]</span>?][? if chancellor_party == "DAP": <span style="color: var(--dap-colour);">[+ chancellor +]</span>?][? if chancellor_party == "NSDAP": <span style="color: var(--nsdap-colour);">[+ chancellor +]</span>?][? if chancellor_party == "KPD": <span style="color: var(--kpd-colour);">[+ chancellor +]</span>?][? if chancellor_party == "I":<span style="color: var(--i-colour);">[+ chancellor +]</span>?][? if chancellor_party == "DNVP": <span style="color: var(--dnvp-colour);">[+ chancellor +]</span>?]</div><div class="exec-portrait-party"><span style="color: var(--text-color);">(</span>[? if chancellor_party == "Z":<span style="color: var(--z-colour);">**Z**</span>?][? if chancellor_party == "SPD":<span style="color: var(--spd-colour);">**SPD**</span>?][? if chancellor_party == "KPD":<span style="color: var(--kpd-colour);">**KPD**</span>?][? if chancellor_party == "SAPD":<span style="color: var(--sapd-colour);">**SAPD**</span>?][? if chancellor_party == "DNVP": <span style="color: var(--dnvp-colour);">**DNVP**</span>?][? if chancellor_party == "NSDAP":<span style="color: var(--nsdap-colour);">**NSDAP**</span>?][? if chancellor_party == "I":<span style="color: var(--i-colour);">**I**</span>?][? if chancellor_party == "USPD": <span style="color: var(--uspd-colour);">**USPD**</span>?][? if chancellor_party == "DAP":DAP?]<span style="color: var(--text-color);">)</span></div></div></div>

<div class="exec-priorities-text"><div><span style="color: var(--text-color);">The</span> [+ ddp_name +] <span style="color: var(--text-color);">is</span> [? if ddp_in_government: <span style="color: var(--text-color);">in government.</span> ?][? if ddp_in_government == 0: <span style="color: var(--text-color);">not currently in government.</span> ?]</div></div>

- @cabinet: Cabinet
- @composition: Legislature
- @root: Return.

@cabinet
new-page: true

= [+ chancellor +] Government

test

- @lets_go: Return.

@lets_go
go-to: execute

@composition
new-page: true
on-display: {!
var _newData = [];
    function _addP(id, legend, seats) {
        if (seats && seats > 0) _newData.push({ id: id, legend: legend, name: legend, seats: seats });
    }
    _addP('kpd', "KPD", Q.kpd_r*5);
    _addP('uspd', 'USPD', Q.uspd_r*5);
    _addP('sapd', 'SAPD', Q.sapd_r*5);
    _addP('spd', 'SPD', Q.spd_r*5);
    _addP('ddp', 'Q.ddp_name', Q.ddp_r*5);
    _addP('z', 'Center', (Q.z_r - 3)*5);
    if (Q.bvp_spilt == 1) _addP('bvp',  'BVP', 3*5);
    _addP('dvp', 'DVP', Q.dvp_r*5);
    _addP('other', 'Other', Q.other_r*5);
    _addP('dnvp', 'DNVP', Q.dnvp_r*5);
    _addP('dap', 'DAP', Q.dap_r*5);
    _addP('nsdap', 'NSDAP', Q.nsdap_r*5);

    var _newSig = JSON.stringify(_newData.map(function(p){ return p.id + p.seats; }));
    var _changed = (_newSig !== window._parliSig);
    window._parliData = _newData;
    if (_changed) {
        window._parliSig = _newSig;
        window._parliAnimate = true;
    } else {
        window._parliAnimate = false;
    }
!}

= The Reichstag

<div style="text-align: center; margin: 1em 0px; display: block;">

<div class="exec-portrait-card"><div class="exec-portrait-frame"><img src="[+ img_r_president +]" alt="ReichstagPresident" decoding="async" loading="eager" fetchpriority="high"></div><div class="exec-portrait-role"><span style="color: var(--text-color);">Präsident des Reichstags</span></div><div class="exec-portrait-name">[? if reichstag_president_party == "SPD": <span style="color: var(--spd-colour);">[+ reichstag_president +]</span>?][? if reichstag_president_party == "USPD": <span style="color: var(--uspd-colour);">[+ reichstag_president +]</span>?][? if reichstag_president_party == "I":<span style="color: var(--i-colour);">[+ reichstag_president +]</span>?][? if reichstag_president_party == "SAPD": <span style="color: var(--sapd-colour);">[+ reichstag_president +]</span>?][? if reichstag_president_party == "DAP": <span style="color: var(--dap-colour);">[+ reichstag_president +]</span>?][? if reichstag_president_party == "Z": <span style="color: var(--z-colour);">[+ reichstag_president +]</span>?][? if reichstag_president_party == "NSDAP": <span style="color: var(--nsdap-colour);">[+ reichstag_president +]</span>?][? if reichstag_president_party == "KPD": <span style="color: var(--kpd-colour);">[+ reichstag_president +]</span>?][? if reichstag_president_party == "DNVP": <span style="color: var(--dnvp-colour);">[+ reichstag_president +]</span>?]</div><div class="exec-portrait-party"><span style="color: var(--text-color);">(</span>[? if reichstag_president_party == "Z":<span style="color: var(--z-colour);">**Z**</span>?][? if reichstag_reichstag_president_party == "SPD":<span style="color: var(--spd-colour);">**SPD**</span>?][? if reichstag_president_party == "KPD":<span style="color: var(--kpd-colour);">**KPD**</span>?][? if reichstag_reichstag_president_party == "SAPD":<span style="color: var(--sapd-colour);">**SAPD**</span>?][? if reichstag_president_party == "DNVP": <span style="color: var(--dnvp-colour);">**DNVP**</span>?][? if reichstag_reichstag_president_party == "NSDAP":<span style="color: var(--nsdap-colour);">**NSDAP**</span>?][? if reichstag_president_party == "I":<span style="color: var(--i-colour);">**I**</span>?][? if reichstag_reichstag_president_party == "USPD": <span style="color: var(--uspd-colour);">**USPD**</span>?][? if reichstag_president_party == "DAP":DAP?][? if reichstag_reichstag_president_party == "I":<span style="color: var(--i-colour);">**I**</span>?]<span style="color: var(--text-color);">)</span></div></div>{!<svg id="status_parliament" style="width: 100%; display: block;"></svg></div></div></div>
<script>
(function() {
    if (!d3 || !d3.parliament || !window._parliData || window._parliData.length === 0) return;
    var el = document.getElementById('status_parliament');
    if (!el) return;
    var w = el.parentElement.offsetWidth || 220;
    el.setAttribute('width', w);
    el.setAttribute('height', Math.round(w * 0.55));
    var parl = d3.parliament();
    parl.width(w).height(Math.round(w * 0.55)).innerRadiusCoef(0.4);
    var animate = window._parliAnimate;
    parl.enter.fromCenter(animate).smallToBig(animate);
    parl.exit.toCenter(animate).bigToSmall(animate);
    d3.select('#status_parliament').datum(window._parliData).call(parl);
})();
</script>!}

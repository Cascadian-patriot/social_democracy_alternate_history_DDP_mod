####################### adding advisors

@add_advisors
title: Add advisors
choose-if: n_advisors < 3
unavailable-subtitle: Maximum of 3 advisors.
go-to: advisor_menu

@advisor_menu
title: Add other advisors.
tags: sammlung_advisor, linksliberale_advisor, nationalliberale_advisor, pazifisten_advisor, nonfactional_advisor
frequency: 1

- @sammlung: Add Sammlung
- @linksliberale: Add Linksliberale
- @nationalliberale: Add Nationalliberale
- @pazifisten: Add Pazifisten
- @nonfactional: Add non-factional advisors
- @rm_main: Remove advisors instead.
- @remove_none: Stop changing advisors.

@sammlung
view-if: n_advisors < 3

- #sammlung_advisor

@linksliberale
view-if: n_advisors < 3

- #linksliberale_advisor

@nationalliberale
view-if: n_advisors < 3

- #nationalliberale_advisor

@pazifisten
view-if: n_advisors < 3


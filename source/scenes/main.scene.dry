- @party
- @govt
- #advisor
- @shuffle_leadership_pinned

@main_easy
set-bg: img/background.jpg
is-hand: true
on-arrival: {!
if (Q.advisor_action_timer <= 0) {
    Q.pinnedCardsDescription = 'Advisors - an action is available.';
} else if (Q.advisor_action_timer == 1) {
    Q.pinnedCardsDescription = 'Advisors - next action available in 1 month.';
} else {
    Q.pinnedCardsDescription = 'Advisors - next action available in ' + Q.advisor_action_timer + ' months.';
}
!}
max-cards: 4

<div class="leader-card">
<h2 class="leader-party">[+ ddp_full_name_german +] ([+ ddp_name +])</h2>
<img class="leader-portrait" src="[+ img_leader +]">
<div class="leader-name">[+ name_leader +]</div>
<div class="leader-role">Party Chair</div>
</div>

- @party
- @govt
- #advisor
- @shuffle_leadership_pinned


@party
title: Party Affairs
card-image: img/ddp_poster_party_affairs.jpeg
is-deck: true

- #party_affairs

@govt
title: Government Affairs
view-if: time >= 6
card-image: img/reichstag_2.jpg
is-deck: true

- #govt_affairs

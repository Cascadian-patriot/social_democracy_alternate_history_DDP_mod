        let total = Q.dsu_votes + Q.nvf_votes + Q.nsdap_hitler_votes;
        let factor = Q.nsdap_votes / total;

        Q.dsu_votes = parseFloat((Q.dsu_votes * factor).toFixed(1));
        Q.nvf_votes = parseFloat((Q.nvf_votes * factor).toFixed(1));

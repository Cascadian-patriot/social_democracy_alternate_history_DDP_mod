title: Reichstag Elections
new-page: true
tags: event
priority: -2
view-if: (year = next_election_year and month >= next_election_month and (next_election_week == week or not rubicon)) or (year > next_election_year)
on-arrival: election_boycott = 0
on-departure: in_election = 0; next_election_year = next_election_year + 4; n_elections += 1; next_election_time = time + 48
set-jump: post_election_1928
set-bg: img/map_2.jpg
#face-image: img/Rothe_Wahlen_1903.jpg


= Elections, [+ month : month +] [+ year +]

<img style="float:left; max-width:42%; margin: 0.3em 12px 12px 0em; border-radius: 6px; border: 4px solid rgb(0, 0, 0);" alt="" src="img/reichstag_3.jpg" fetchpriority="auto" loading="lazy" decoding="async" class="rich-image rich-image-left"> The Reichstag elections are to be held now. The Reichstag is elected every 4 years based on the principles of universal and secret suffrage, using party-list proportional representation. The Reich is divided into 35 electoral districts (Wahlkreis) that are combined into 16 electoral associations (Wahlkreisverband). Parties draw a list of electoral candidates for each electoral district they were participating in and for the federal level.

- @election_algorithm: May we do our best...

@post_election_1928
on-arrival: {!  
    Q.pre_previous_z_last_election_votes = Q.previous_z_last_election_votes;
    Q.z_votes_pre = Q.z_votes;

    Q.adjustmentFactors_votes_spd = 1.0;
    Q.adjustmentFactors_votes_sapd = 1.0;
    Q.adjustmentFactors_votes_kpd = 1.0;
    Q.adjustmentFactors_votes_z = 1.0;
    Q.adjustmentFactors_votes_ddp = 1.0;
    Q.adjustmentFactors_votes_dvp = 1.0;
    Q.adjustmentFactors_votes_lvp = 1.0;
    Q.adjustmentFactors_votes_dnvp = 1.0;
    Q.adjustmentFactors_votes_nsdap = 1.0;
    Q.adjustmentFactors_votes_dnf = 1.0;
    Q.adjustmentFactors_votes_kvp = 1.0;
    Q.adjustmentFactors_votes_other = 1.0;

    Q.adjustmentFactors_spd = 1.0;
    Q.adjustmentFactors_sapd = 1.0;
    Q.adjustmentFactors_kpd = 1.0;
    Q.adjustmentFactors_z = 1.0;
    Q.adjustmentFactors_ddp = 1.0;
    Q.adjustmentFactors_dvp = 1.0;
    Q.adjustmentFactors_lvp = 1.0;
    Q.adjustmentFactors_dnvp = 1.0;
    Q.adjustmentFactors_nsdap = 1.0;
    Q.adjustmentFactors_dnf = 1.0;
    Q.adjustmentFactors_dnef = 1.0;
    Q.adjustmentFactors_kvp = 1.0;
    Q.adjustmentFactors_other = 0.75;

    var new_party_sum = 0;
    var total_reichstag_without = 0;  // Initialize a variable to accumulate 'reichstag_without_' values
    var total_other_party_sum = 0;    // Initialize a variable to accumulate '_other_party_sum' values
    if (Q.year === 1928 && Q.dnvp_leader === "Hugenberg" || Q.dnvp_westarp) {
        Q.adjustmentFactors_other = 0.75;
    } else if (Q.year === 1929 && Q.dnvp_leader === "Hugenberg") {
        Q.adjustmentFactors_other = 0.85;
    } else if (Q.year === 1930 && Q.dnvp_leader === "Hugenberg") {
        Q.adjustmentFactors_other = 0.9;
    } else if (Q.year === 1931 && Q.dnvp_leader === "Hugenberg") {
        Q.adjustmentFactors_other = 0.8;
    } else if (Q.year >= 1932 && Q.dnvp_leader === "Hugenberg") {
        Q.adjustmentFactors_other = 0.6;
    } else if (Q.year >= 1928 && Q.dnvp_leader === "Triumvirate") {
        Q.adjustmentFactors_other = 0.75;
    } else if (Q.year === 1928 && Q.dnvp_ideology === "Moderate") {
        Q.adjustmentFactors_other = 0.65;
    } else if (Q.year === 1929 && Q.dnvp_ideology === "Moderate") {
        Q.adjustmentFactors_other = 0.7;
    } else if (Q.year === 1930 && Q.dnvp_ideology === "Moderate") {
        Q.adjustmentFactors_other = 0.75;
    } else if (Q.year === 1931 && Q.dnvp_ideology === "Moderate") {
        Q.adjustmentFactors_other = 0.7;
    } else if (Q.year >= 1932 && Q.dnvp_ideology === "Moderate") {
        Q.adjustmentFactors_other = 0.6;
    }
    if (Q.kvp_cnblp_sister) {
        Q.adjustmentFactors_other += 0.05;
    }
    if (Q.bourgeois_parliament || Q.bourgeois_parliament_no_liberals) {
        Q.adjustmentFactors_other += 0.05;
    }
    if (Q.other_votes >= 8 && Q.year >= 1931) {
        Q.adjustmentFactors_other += 0.1;
    }
    if (Q.other_dnef) {
        Q.adjustmentFactors_other = 0;
    }
    if (Q.cvp_formed) Q.adjustmentFactors_other = 0.6;
    if (Q.aspd_other) Q.adjustmentFactors_other += 0.4;
    Q.adjustmentFactors_ddp = 1.0;
    if (!Q.bourgeois_list_ddp && !Q.dstp_dnef) {
        if (Q.ddp_votes < 1 && Q.year >= 1930) {
            Q.adjustmentFactors_ddp = 0.3;
        } else if (Q.ddp_votes < 1.5 && Q.year >= 1930) {
            Q.adjustmentFactors_ddp = 0.65;
        } else if (Q.ddp_votes < 3 && Q.year >= 1930) {
            Q.adjustmentFactors_ddp = 0.75;
        } else if (Q.ddp_votes < 4 && Q.year >= 1930) {
            Q.adjustmentFactors_ddp = 0.85;
        }
    }
    if (Q.ddp_alliance) Q.adjustmentFactors_ddp = 0.8;
    if (Q.ddp_alliance_glaze) Q.adjustmentFactors_ddp = 1.1;
    Q.adjustmentFactors_dvp = 1.0;
    if (!Q.hugenberg_dvp && !Q.bourgeois_list && !Q.dvp_dnef) {
        if (Q.dvp_votes < 1.5) {
            Q.adjustmentFactors_dvp = 0.25;
        } else if (Q.dvp_votes < 2) {
            Q.adjustmentFactors_dvp = 0.4;
        } else if (Q.dvp_votes < 2.5) {
            Q.adjustmentFactors_dvp = 0.6;            
        } else if (Q.dvp_votes < 3) {
            Q.adjustmentFactors_dvp = 0.8;   
        }
    }
    if (Q.hugenberg_dvp) Q.adjustmentFactors_dvp = 1.0;

    if (Q.election_boycott) {
        Q.adjustmentFactors_votes_spd = 1.0*(1-Q.spd_boycott_efficacy);
        Q.adjustmentFactors_votes_sapd = 0.0;
        Q.adjustmentFactors_votes_kpd = 0.0;
        Q.adjustmentFactors_votes_z = 1.0*(1-Q.z_boycott_efficacy);
        Q.adjustmentFactors_votes_ddp = 1.0*(1-Q.lib_boycott_efficacy);
        Q.adjustmentFactors_votes_dvp = 1.0*(1.2-Q.lib_boycott_efficacy);
        Q.adjustmentFactors_votes_lvp = 1.0*(1-Q.lib_boycott_efficacy);
        Q.adjustmentFactors_votes_dnvp = 1.0;
        if (Q.dnvp_ideology == "Radical") Q.adjustmentFactors_votes_dnvp = 0.6;
        Q.adjustmentFactors_votes_nsdap = 1.0;
        if (Q.nvf_exist && !Q.nvf_dnef) Q.adjustmentFactors_votes_nsdap -= 0.1;
        Q.adjustmentFactors_votes_dnf = 1.0;
        if (Q.dnvp_ideology == "Moderate") Q.adjustmentFactors_votes_dnf = 0.4;
        Q.adjustmentFactors_votes_kvp = 1.0;
        Q.adjustmentFactors_votes_other = 1.0;

        Q.kpd_banned = 1;
        Q.sapd_banned = 1;
        Q.spd_banned = 1;
        if (Q.z_boycott_efficacy >= 0.74) Q.z_banned = 1;
        if (Q.lib_boycott_efficacy >= 0.74) Q.ddp_banned = 1;
        if (Q.lib_boycott_efficacy >= 0.89) Q.dvp_banned = 1;
        if (Q.lib_boycott_efficacy >= 0.74) Q.lvp_banned = 1;
        if (Q.dnvp_ideology == "Radical") Q.dnvp_banned = 1;
        if (Q.dnvp_ideology == "Moderate") Q.dnf_banned = 1;
    } else {
        Q.spd_banned = 0;
        Q.z_banned = 0;
        Q.ddp_banned = 0;
        Q.dvp_banned = 0;
        Q.lvp_banned = 0;
        Q.dnvp_banned = 0;
        Q.dnf_banned = 0;
    }
    let total_adjusted_votes = 0;
    for (var party of Q.parties) {
        let factor = Q['adjustmentFactors_votes_' + party] || 1.0;
        Q['original_' + party + '_votes'] = Q[party + '_votes'];
        Q[party + '_votes'] = Q[party + '_votes'] * factor;
        total_adjusted_votes += Q[party + '_votes'];
    }

    let normalization_factor = 100 / total_adjusted_votes;
    Q.boycott_effect = normalization_factor;
    for (var party of Q.parties) {
        Q[party + '_votes'] = Math.round(Q[party + '_votes'] * normalization_factor * 10) / 10;
    }
    // Step 1: Calculate adjusted values and the sum for redistribution
    for (var party of Q.parties) {
        let factor = Q['adjustmentFactors_' + party] || 1.0; // Default to 1.0 if not set
        
        Q['old_' + party + '_r'] = Q[party + '_r']; // Store the original r value for comparison
        
        // Handle constitutional reform logic: set the party's share to 0 based on conditions
        if ((Q.constitutional_reform > 0 &&
             (Q[party + '_votes'] < Q.electoral_threshold || 
             (Q.electoral_threshold > 1 && party === 'other'))) 
            || Q[party + '_banned']) {
            Q[party + '_r'] = 0;
        } else {
            // Adjust `r` based on the adjustment factor if not affected by constitutional reform
            Q['original_' + party + '_r'] = Math.round(Q[party + '_votes'] * 10) / 10;
            Q[party + '_r'] = Math.round(Q[party + '_votes'] * factor * 10) / 10;
        }
        
        if (Q[party + '_r'] > 0) {
            if (factor !== 1.0) { // Only apply to parties with adjustment factors
                // Calculate the Reichstag without the current party's share
                Q['reichstag_without_' + party] = 100 - Q['original_' + party + '_r'];
                total_reichstag_without += Q['reichstag_without_' + party]; // Accumulate the total of 'reichstag_without_' values

                // Calculate the sum of the remaining parties
                Q[party + '_other_party_sum'] = Q['reichstag_without_' + party] - (Q[party + '_votes'] - Q[party + '_r']);
                total_other_party_sum += Q[party + '_other_party_sum']; // Accumulate the total of '_other_party_sum' values
            } else {
                // For non-adjusted parties, accumulate their r value for the redistribution
                new_party_sum += Q[party + '_r'];
            }
        }
    }
    
console.log(Q.spd_r)

// Step 2: Redistribute results among non-adjusted parties to ensure the total is 100%
if (new_party_sum > 0) {
    for (var party of Q.parties) {
        let factor = Q['adjustmentFactors_' + party] || 1.0;

        if (Q[party + '_r'] === 0) continue;

        var total_reichstag_without_party = total_reichstag_without - (100 - Q['original_' + party + '_r']);
        var total_other_party_sum_party = total_other_party_sum - (Q['reichstag_without_' + party] - (Q[party + '_votes'] - Q[party + '_r']));

        console.log(Q.spd_r)

        if (factor === 1.0) {
            if (total_other_party_sum > 0) {
                Q[party + '_r'] = Math.round((Q[party + '_r'] * total_reichstag_without) / total_other_party_sum * 10) / 10;
            } else {
                Q[party + '_r'] = Q[party + '_r'];
            }
        } else if (factor !== 1.0 && total_reichstag_without_party > 0 && total_other_party_sum_party > 0) {
            let scaling_factor = total_reichstag_without_party / total_other_party_sum_party;
            Q[party + '_r'] = Math.round(Q[party + '_r'] * scaling_factor * 10) / 10;
        }
    }

    console.log(Q.spd_r)

    // Step 3: Normalize to ensure the total sums to exactly 100%
    let total_r_sum = 0;

    // Calculate the total of all `r` values after redistribution
    for (var party of Q.parties) {
        total_r_sum += Q[party + '_r'];
    }

    // Adjust each party's `r` value proportionally if the total isn't 100
    if (total_r_sum !== 100) {
        let normalization_factor = 100 / total_r_sum;
        for (var party of Q.parties) {
            if (Q[party + '_r'] > 0) {
                Q[party + '_r'] = Math.round(Q[party + '_r'] * normalization_factor * 10) / 10;
            }
        }
    }
    console.log(Q.spd_r)
}
if (Q.election_boycott) {
    Q.dnef_votes += Q.spd_votes;
    Q.spd_votes = 0;
    if (Q.z_boycott_efficacy >= 0.74) {
        Q.dnef_votes += Q.z_votes;
        Q.z_votes = 0;
    }
    if (Q.lib_boycott_efficacy >= 0.74) { 
        Q.dnef_votes += Q.ddp_votes;
        Q.ddp_votes = 0;
    }
    if (Q.lib_boycott_efficacy >= 0.89) { 
        Q.dnef_votes += Q.lvp_votes;
        Q.dvp_votes = 0;
    }
    if (Q.lib_boycott_efficacy >= 0.74) { 
        Q.dnef_votes += Q.dvp_votes;
        Q.lvp_votes = 0;
    }
    if (Q.dnvp_ideology == "Radical") {
        Q.dnef_votes += Q.dnvp_votes;
        Q.dnvp_votes = 0;
    }
    if (Q.dnvp_ideology == "Moderate") {
        Q.dnef_votes += Q.dnf_votes;
        Q.dnf_votes = 0;
    }
}
if (Q.dnef_formed) {
    Q.schleicher_dnef_r = Q.dnef_r;
    Q.schleicher_dnef_votes = Q.dnef_votes;
    if (Q.right_dnef) Q.schleicher_dnef_votes -= Q.right_dnef_votes;
    if (Q.left_dnef) Q.schleicher_dnef_votes -= Q.left_dnef_votes;

    if (Q.ddp_r) Q.ddp_r_last = Q.ddp_r;
    if (Q.lvp_r) Q.lvp_r_last = Q.lvp_r;
    if (Q.kvp_r) Q.kvp_r_last = Q.kvp_r;
    if (Q.dvp_r) Q.dvp_r_last = Q.dvp_r;
    if (Q.z_r) Q.z_r_last = Q.z_r;
    if (Q.bvp_r) Q.bvp_r_last = Q.bvp_r;
    if (Q.dnvp_r) Q.dnvp_r_last = Q.dnvp_r;
    if (Q.other_r) Q.other_r_last = Q.other_r;
    if (Q.nvf_r) Q.nvf_r_last = Q.nvf_r;

    if (Q.other_dnef) {
        if (Q.other_r) {
            Q.dnef_r += Q.other_r;
            Q.other_r = 0;
        }
        Q.dnef_votes += Q.other_votes;
    }
    if (Q.dstp_dnef) {
        if (Q.ddp_r) {
            Q.dnef_r += Q.ddp_r;
            Q.ddp_r = 0;
        }
        Q.dnef_votes += Q.ddp_votes;
    }
    if (Q.lvp_dnef) {
        if (Q.lvp_r) {
            Q.dnef_r += Q.lvp_r;
            Q.lvp_r = 0;
        }
        Q.dnef_votes += Q.lvp_votes;
    }
    if (Q.kvp_dnef) {
        if (Q.kvp_r) {
            Q.dnef_r += Q.kvp_r;
            Q.kvp_r = 0;
        }
        Q.dnef_votes += Q.kvp_votes;
    }
    if (Q.dvp_dnef) {
        if (Q.dvp_r) {
            Q.dnef_r += Q.dvp_r;
            Q.dvp_r = 0;
        }
        Q.dnef_votes += Q.dvp_votes;
    }
    if (Q.z_dnef) {
        if (Q.z_r) {
            Q.dnef_r += Q.z_r;
            Q.z_r = 0;
            Q.bvp_r = 0;
        }
        Q.dnef_votes += Q.z_votes;
    }
    if (Q.dnvp_dnef) {
        if (Q.dnvp_r) {
            Q.dnef_r += Q.dnvp_r;
            Q.dnvp_r = 0;
        }
        Q.dnef_votes += Q.dnvp_votes;
    }
    Q.dnef_votes = Math.round(Q.dnef_votes * 10) / 10;
    console.log(Q.dnef_r)
    Q.dnef_r = Math.round(Q.dnef_r * 10) / 10;
}
    // Step 3: Calculate changes in results
    for (var party of Q.parties) {
        Q['change_' + party + '_r'] = Q[party + '_r'] - Q['old_' + party + '_r'];
        var sign = Q['change_' + party + '_r'] > 0 
                   ? '<img src="img/arrowup.png"> ' 
                   : Q['change_' + party + '_r'] < 0 
                     ? '<img src="img/arrowdown.png"> ' 
                     : '<img src="img/steady.png"> ';
        Q['change_' + party + '_r'] = Math.abs(Q['change_' + party + '_r']);
        Q['str_change_' + party] = sign + parseFloat(Q['change_' + party + '_r']).toFixed(1);
    
        // Calculate changes in votes
        Q['change_' + party + '_votes'] = Q[party + '_votes'] - Q['previous_' + party + '_last_election_votes'];
        if (Q['previous_' + party + '_last_election_votes'] === undefined) {
            Q['change_' + party + '_votes'] = Q[party + '_votes'];
        }
        var sign2 = Q['change_' + party + '_votes'] > 0 
                    ? '<img src="img/arrowup.png"> ' 
                    : Q['change_' + party + '_votes'] < 0 
                      ? '<img src="img/arrowdown.png"> ' 
                      : '<img src="img/steady.png"> ';
        Q['str_votes_change_' + party] = sign2 + Math.abs(Q['change_' + party + '_votes']).toFixed(1);
    }
    
    // Handle demographic changes for all parties
    for (var party of Q.parties) {
        for (var c of Q.classes) {
            Q[c + "_change_" + party + '_display'] = Q[c + '_' + party + '_display'] - Q['old_' + c + '_' + party + '_display'];
            var sign3 = Q[c + "_change_" + party + '_display'] > 0 ? '+' : '';
            Q['demo_change_' + c + '_' + party + '_display'] = sign3 + parseFloat(Q[c + "_change_" + party + '_display']).toFixed(0);
            Q['old_' + c + '_' + party + '_display'] = Q[c + '_' + party + '_display'];
        }
    }
    
    // Store current votes as previous for the next iteration
    for (var party of Q.parties) {
        Q[party + '_last_election_votes'] = parseFloat(Q[party + '_votes']).toFixed(1);
        Q['previous_' + party + '_last_election_votes'] = parseFloat(parseFloat(Q[party + '_last_election_votes']).toFixed(1));
    }    
    
if (Q.change_spd_votes <= 0) Q.notwendigkeit = 0;
if (Q.year == 1928 && Q.month == 5) Q.modeerscheinung_check = Q.nsdap_votes;

Q.cnblp_r = 0;
Q.wp_r = 0;
Q.csvd_r = 0;
Q.aspd_r = 0;

if (Q.cnblp_votes) Q.cnblp_r = Math.round(Q.cnblp_votes * Q.adjustmentFactors_other * 10) / 10;
if (Q.wp_votes) Q.wp_r = Math.round(Q.wp_votes * Q.adjustmentFactors_other * 10) / 10;
if (Q.csvd_votes) Q.csvd_r = Math.round(Q.csvd_votes * Q.adjustmentFactors_other * 10) / 10;
if (Q.aspd_votes) Q.aspd_r = Math.round(Q.aspd_votes * Q.adjustmentFactors_other * 10) / 10;

if (Q.dnef_formed) {
    Q.cnblp_r = 0;
    Q.wp_r = 0;
    Q.csvd_r = 0;
}
if (Q.electoral_threshold > 1) {
    Q.cnblp_r = 0;
    Q.wp_r = 0;
    Q.csvd_r = 0;
}
Q.true_other_r = Q.other_r - Q.cnblp_r - Q.wp_r - Q.csvd_r - Q.aspd_r;
if (!Q.csvd_formed && !Q.aspd_other) Q.true_other_r += Q.csvd_r;
if (!Q.aspd_other) Q.true_other_r += Q.aspd_r;

if (!Q.bavaria_spd) Q.bvp_votes = Q.z_votes*0.2;
if (Q.bavaria_spd) Q.bvp_votes = Q.z_votes*0.1;
if (Q.election_boycott) {
    if (!Q.bavaria_spd && Q.z_boycott_efficacy >= 0.74) Q.bvp_votes = Q.z_votes_pre*0.2;
    if (Q.bavaria_spd && Q.z_boycott_efficacy >= 0.74) Q.bvp_votes = Q.z_votes_pre*0.1;
}
if (Q.bvp_votes > 3.6 && !Q.cvp_formed) {
    Q.bvp_votes = 3.6;
} else if (Q.bvp_votes > 3.9 && Q.cvp_formed) {
    Q.bvp_votes = 3.9;
}
if (!Q.z_dnef) Q.bvp_r = Q.bvp_votes*1.05;
if (Q.bvp_r > 3.7 && !Q.cvp_formed) {
    Q.bvp_r = 3.7;
} else if (Q.bvp_r > 4.0 && Q.cvp_formed) {
    Q.bvp_r = 4.0;
}

if (!Q.z_dnef) Q.bvp_r = parseFloat(Q.bvp_r.toFixed(1));
Q.bvp_votes = parseFloat(Q.bvp_votes.toFixed(1));

Q.z_minus_bvp_votes = parseFloat((Q.z_votes - Q.bvp_votes).toFixed(1));
Q.z_minus_bvp_r = parseFloat((Q.z_r - Q.bvp_r).toFixed(1));
if (Q.election_boycott && Q.z_boycott_efficacy >= 0.74) {
    Q.z_minus_bvp_votes = 0;
    Q.z_minus_bvp_r = 0;
    Q.z_r = Q.bvp_r;
}

console.log("z_minus_bvp_votes:", Q.z_minus_bvp_votes);
console.log("pre_previous_z_last_election_votes:", Q.pre_previous_z_last_election_votes);

Q.str_votes_change_bvp = Q.bvp_votes - Q.previous_bvp_last_election_votes;
var sign2 = Q.str_votes_change_bvp > 0 
? '<img src="img/arrowup.png"> ' 
: Q.str_votes_change_bvp < 0 
  ? '<img src="img/arrowdown.png"> ' 
  : '<img src="img/steady.png"> ';
Q.str_votes_change_bvp = sign2 + Math.abs(Q.str_votes_change_bvp).toFixed(1);

Q.str_change_bvp = Q.bvp_r - Q.old_bvp_r;
var sign2 = Q.str_change_bvp > 0 
? '<img src="img/arrowup.png"> ' 
: Q.str_change_bvp < 0 
  ? '<img src="img/arrowdown.png"> ' 
  : '<img src="img/steady.png"> ';
Q.str_change_bvp = sign2 + Math.abs(Q.str_change_bvp).toFixed(1);

if (Q.bvp_r) {
    Q.pre_previous_z_last_election_votes -= Q.previous_bvp_last_election_votes;
    Q.old_z_r -= Q.old_bvp_r;
}
Q.previous_bvp_last_election_votes = Q.bvp_votes;
Q.old_bvp_r = Q.bvp_r;

console.log("z_minus_bvp_votes:", Q.z_minus_bvp_votes);
console.log("pre_previous_z_last_election_votes:", Q.pre_previous_z_last_election_votes);

Q.str_votes_change_z = Q.z_minus_bvp_votes - Q.pre_previous_z_last_election_votes;
var sign2 = Q.str_votes_change_z > 0 
? '<img src="img/arrowup.png"> ' 
: Q.str_votes_change_z < 0 
  ? '<img src="img/arrowdown.png"> ' 
  : '<img src="img/steady.png"> ';
Q.str_votes_change_z = sign2 + Math.abs(Q.str_votes_change_z).toFixed(1);

console.log(Q.dsu_votes)
console.log(Q.nsdap_hitler_votes)
console.log(Q.nvf_votes)

if (Q.nsdap_split) {
    if (Q.dsu_exist) {
        Q.dsu_r = parseFloat(Q.dsu_votes.toFixed(1));
        Q.dsu_votes = parseFloat(Q.dsu_votes.toFixed(1));
    }
    if (Q.nvf_exist) {
        Q.nvf_r = parseFloat(Q.nvf_votes.toFixed(1));
        Q.nvf_votes = parseFloat(Q.nvf_votes.toFixed(1));
        if (Q.election_boycott && !Q.nvf_dnef) {
            Q.nvf_r = 0;
            Q.nvf_votes = 0;
        }
    }
    if (Q.dsu_exist || Q.nvf_exist) {
        Q.nsdap_hitler_r = parseFloat(Q.nsdap_hitler_votes.toFixed(1));
        Q.nsdap_hitler_votes = parseFloat(Q.nsdap_hitler_votes.toFixed(1));
    }
    if ((Q.dsu_votes + Q.nvf_votes + Q.nsdap_hitler_votes) !== Q.nsdap_votes) {
        let total = Q.dsu_votes + Q.nvf_votes + Q.nsdap_hitler_votes;
        let factor = Q.nsdap_votes / total;

        Q.dsu_votes = parseFloat((Q.dsu_votes * factor).toFixed(1));
        Q.nvf_votes = parseFloat((Q.nvf_votes * factor).toFixed(1));
        Q.nsdap_hitler_votes = parseFloat((Q.nsdap_hitler_votes * factor).toFixed(1));
    }
    if ((Q.dsu_r + Q.nvf_r + Q.nsdap_hitler_r) !== Q.nsdap_r) {
        let total = Q.dsu_r + Q.nvf_r + Q.nsdap_hitler_r;
        let factor = Q.nsdap_r / total;

        Q.dsu_r = parseFloat((Q.dsu_r * factor).toFixed(1));
        Q.nvf_r = parseFloat((Q.nvf_r * factor).toFixed(1));
        Q.nsdap_hitler_r = parseFloat((Q.nsdap_hitler_r * factor).toFixed(1));
    }
    if (Q.dsu_exist) {
        Q.str_votes_change_dsu = Q.dsu_votes - Q.previous_dsu_last_election_votes;
        var sign2 = Q.str_votes_change_dsu > 0 ?
            '<img src="img/arrowup.png"> ' :
            Q.str_votes_change_dsu < 0 ?
            '<img src="img/arrowdown.png"> ' :
            '<img src="img/steady.png"> ';
        Q.str_votes_change_dsu = sign2 + Math.abs(Q.str_votes_change_dsu).toFixed(1);

        Q.str_change_dsu = Q.dsu_r - Q.old_dsu_r;
        var sign2 = Q.str_change_dsu > 0 ?
            '<img src="img/arrowup.png"> ' :
            Q.str_change_dsu < 0 ?
            '<img src="img/arrowdown.png"> ' :
            '<img src="img/steady.png"> ';
        Q.str_change_dsu = sign2 + Math.abs(Q.str_change_dsu).toFixed(1);
    }
    if (Q.nvf_exist) {
        Q.str_votes_change_nvf = Q.nvf_votes - Q.previous_nvf_last_election_votes;
        var sign2 = Q.str_votes_change_nvf > 0 ?
            '<img src="img/arrowup.png"> ' :
            Q.str_votes_change_nvf < 0 ?
            '<img src="img/arrowdown.png"> ' :
            '<img src="img/steady.png"> ';
        Q.str_votes_change_nvf = sign2 + Math.abs(Q.str_votes_change_nvf).toFixed(1);

        Q.str_change_nvf = Q.nvf_r - Q.old_nvf_r;
        var sign2 = Q.str_change_nvf > 0 ?
            '<img src="img/arrowup.png"> ' :
            Q.str_change_nvf < 0 ?
            '<img src="img/arrowdown.png"> ' :
            '<img src="img/steady.png"> ';
        Q.str_change_nvf = sign2 + Math.abs(Q.str_change_nvf).toFixed(1);
    }
    if (Q.nvf_exist || Q.dsu_exist) {
        if (Q.previous_nsdap_hitler_last_election_votes == 0) Q.previous_nsdap_hitler_last_election_votes = Q.previous_nsdap_last_election_votes
        if (Q.old_nsdap_hitler_r == 0) Q.old_nsdap_hitler_r = Q.old_nsdap_r

        Q.str_votes_change_nsdap_hitler = Q.nsdap_hitler_votes - Q.previous_nsdap_hitler_last_election_votes;
        var sign2 = Q.str_votes_change_nsdap_hitler > 0 ?
            '<img src="img/arrowup.png"> ' :
            Q.str_votes_change_nsdap_hitler < 0 ?
            '<img src="img/arrowdown.png"> ' :
            '<img src="img/steady.png"> ';
        Q.str_votes_change_nsdap_hitler = sign2 + Math.abs(Q.str_votes_change_nsdap_hitler).toFixed(1);

        Q.str_change_nsdap_hitler = Q.nsdap_hitler_r - Q.old_nsdap_hitler_r;
        var sign2 = Q.str_change_nsdap_hitler > 0 ?
            '<img src="img/arrowup.png"> ' :
            Q.str_change_nsdap_hitler < 0 ?
            '<img src="img/arrowdown.png"> ' :
            '<img src="img/steady.png"> ';
        Q.str_change_nsdap_hitler = sign2 + Math.abs(Q.str_change_nsdap_hitler).toFixed(1);
    }
    Q.previous_dsu_last_election_votes = Q.dsu_votes;
    Q.old_dsu_r = Q.dsu_r;
    Q.previous_nvf_last_election_votes = Q.nvf_votes;
    Q.old_nvf_r = Q.nvf_r;
    Q.previous_nsdap_hitler_last_election_votes = Q.nsdap_hitler_votes;
    Q.old_nsdap_hitler_r = Q.nsdap_hitler_r;
}

if (Q.rdp_list) {
    Q.rdp_votes = Q.new_middle_spd_normalized;
    Q.rdp_votes *= (Q.spd_votes / 100);
    if (Q.pro_republic >= 15) Q.rdp_votes *= (Q.pro_republic / 100);
    if (Q.pro_republic < 15) Q.rdp_votes *= 0.15;
    if (Q.rdp_votes < 0.5) Q.rdp_votes = 0.5;
    Q.rdp_r = Q.rdp_votes*(Q.spd_r / Q.spd_votes);

    Q.rdp_votes = Math.round(Q.rdp_votes * 10) / 10;

    Q.spd_votes -= Q.rdp_votes;

    // vote share
    Q.str_votes_change_rdp = Q.rdp_votes - Q.previous_rdp_last_election_votes;
    var sign2 = Q.str_votes_change_rdp > 0 ?
        '<img src="img/arrowup.png"> ' :
        Q.str_votes_change_rdp < 0 ?
        '<img src="img/arrowdown.png"> ' :
        '<img src="img/steady.png"> ';
    Q.str_votes_change_rdp = sign2 + Math.abs(Q.str_votes_change_rdp).toFixed(1);
    Q.previous_rdp_last_election_votes = Q.rdp_votes;

    Q.str_votes_change_spd = Q.spd_votes - Q.previous_spd_last_election_votes;
    var sign2 = Q.str_votes_change_spd > 0 ?
        '<img src="img/arrowup.png"> ' :
        Q.str_votes_change_spd < 0 ?
        '<img src="img/arrowdown.png"> ' :
        '<img src="img/steady.png"> ';
    Q.str_votes_change_spd = sign2 + Math.abs(Q.str_votes_change_spd).toFixed(1);
    Q.previous_spd_last_election_votes = Q.spd_votes;

    // reichstag share

    Q.str_change_rdp = Q.rdp_r - Q.old_rdp_r;
    var sign2 = Q.str_change_rdp > 0 ?
        '<img src="img/arrowup.png"> ' :
        Q.str_change_rdp < 0 ?
        '<img src="img/arrowdown.png"> ' :
        '<img src="img/steady.png"> ';
    Q.str_change_rdp = sign2 + Math.abs(Q.str_change_rdp).toFixed(1);
    Q.old_rdp_r = Q.rdp_r;

    Q.str_change_spd = Q.spd_r - Q.old_spd_r;
    var sign2 = Q.str_change_spd > 0 ?
        '<img src="img/arrowup.png"> ' :
        Q.str_change_spd < 0 ?
        '<img src="img/arrowdown.png"> ' :
        '<img src="img/steady.png"> ';
    Q.str_change_spd = sign2 + Math.abs(Q.str_change_spd).toFixed(1);
    Q.old_spd_r = Q.spd_r;
}

if (Q.aspd_kvp) {
    Q.true_aspd_r = Q.aspd_votes*(Q.kvp_r / Q.kvp_votes);
    Q.kvp_votes -= Q.aspd_votes;
    Q.aspd_r = 0;

    Q.str_votes_change_aspd = Q.aspd_votes - Q.previous_aspd_last_election_votes;
    var sign2 = Q.str_votes_change_aspd > 0 ?
        '<img src="img/arrowup.png"> ' :
        Q.str_votes_change_aspd < 0 ?
        '<img src="img/arrowdown.png"> ' :
        '<img src="img/steady.png"> ';
    Q.str_votes_change_aspd = sign2 + Math.abs(Q.str_votes_change_aspd).toFixed(1);
    Q.previous_aspd_last_election_votes = Q.aspd_votes;

    Q.str_votes_change_kvp = Q.kvp_votes - Q.previous_kvp_last_election_votes;
    var sign2 = Q.str_votes_change_kvp > 0 ?
        '<img src="img/arrowup.png"> ' :
        Q.str_votes_change_kvp < 0 ?
        '<img src="img/arrowdown.png"> ' :
        '<img src="img/steady.png"> ';
    Q.str_votes_change_kvp = sign2 + Math.abs(Q.str_votes_change_kvp).toFixed(1);
    Q.previous_kvp_last_election_votes = Q.kvp_votes;

    // reichstag share

    Q.str_change_aspd = Q.aspd_r - Q.old_aspd_r;
    var sign2 = Q.str_change_aspd > 0 ?
        '<img src="img/arrowup.png"> ' :
        Q.str_change_aspd < 0 ?
        '<img src="img/arrowdown.png"> ' :
        '<img src="img/steady.png"> ';
    Q.str_change_aspd = sign2 + Math.abs(Q.str_change_aspd).toFixed(1);
    Q.old_aspd_r = Q.aspd_r;

    Q.str_change_kvp = Q.kvp_r - Q.old_kvp_r;
    var sign2 = Q.str_change_kvp > 0 ?
        '<img src="img/arrowup.png"> ' :
        Q.str_change_kvp < 0 ?
        '<img src="img/arrowdown.png"> ' :
        '<img src="img/steady.png"> ';
    Q.str_change_kvp = sign2 + Math.abs(Q.str_change_kvp).toFixed(1);
    Q.old_kvp_r = Q.kvp_r;
}

if (Q.aspd_other) {
    Q.true_aspd_r = Q.aspd_votes*(Q.other_r / Q.other_votes);
    Q.other_votes -= Q.aspd_votes;
    Q.aspd_r = 0;

    Q.str_votes_change_aspd = Q.aspd_votes - Q.previous_aspd_last_election_votes;
    var sign2 = Q.str_votes_change_aspd > 0 ?
        '<img src="img/arrowup.png"> ' :
        Q.str_votes_change_aspd < 0 ?
        '<img src="img/arrowdown.png"> ' :
        '<img src="img/steady.png"> ';
    Q.str_votes_change_aspd = sign2 + Math.abs(Q.str_votes_change_aspd).toFixed(1);
    Q.previous_aspd_last_election_votes = Q.aspd_votes;

    Q.str_votes_change_other = Q.other_votes - Q.previous_other_last_election_votes;
    var sign2 = Q.str_votes_change_other > 0 ?
        '<img src="img/arrowup.png"> ' :
        Q.str_votes_change_other < 0 ?
        '<img src="img/arrowdown.png"> ' :
        '<img src="img/steady.png"> ';
    Q.str_votes_change_other = sign2 + Math.abs(Q.str_votes_change_other).toFixed(1);
    Q.previous_other_last_election_votes = Q.other_votes;

    // reichstag share

    Q.str_change_aspd = Q.aspd_r - Q.old_aspd_r;
    var sign2 = Q.str_change_aspd > 0 ?
        '<img src="img/arrowup.png"> ' :
        Q.str_change_aspd < 0 ?
        '<img src="img/arrowdown.png"> ' :
        '<img src="img/steady.png"> ';
    Q.str_change_aspd = sign2 + Math.abs(Q.str_change_aspd).toFixed(1);
    Q.old_aspd_r = Q.aspd_r;

    Q.str_change_other = Q.other_r - Q.old_other_r;
    var sign2 = Q.str_change_other > 0 ?
        '<img src="img/arrowup.png"> ' :
        Q.str_change_other < 0 ?
        '<img src="img/arrowdown.png"> ' :
        '<img src="img/steady.png"> ';
    Q.str_change_other = sign2 + Math.abs(Q.str_change_other).toFixed(1);
    Q.old_other_r = Q.other_r;
}

if (Q.dnef_formed && Q.nvf_exist) {
    if (Q.nvf_dnef) {
        if (Q.nvf_r) {
            Q.dnef_r += Q.nvf_r;
            Q.nvf_r = 0;
        }
        Q.dnef_votes += Q.nvf_votes;
    }
    Q.dnef_votes = Math.round(Q.dnef_votes * 10) / 10;
    Q.dnef_r = Math.round(Q.dnef_r * 10) / 10;
}

if (Q.dnef_formed) {
    Q.true_dnef_r = Math.round(Q.dnef_r * 10) / 10;
    Q.right_dnef_r = 0;
    Q.left_dnef_r = 0;
    Q.str_votes_change_schleicher_dnef = Q.schleicher_dnef_votes - Q.previous_schleicher_dnef_last_election_votes;
    
    var sign2 = Q.str_votes_change_schleicher_dnef > 0 ?
        '<img src="img/arrowup.png"> ' :
        Q.str_votes_change_schleicher_dnef < 0 ?
        '<img src="img/arrowdown.png"> ' :
        '<img src="img/steady.png"> ';
    Q.str_votes_change_schleicher_dnef = sign2 + Math.abs(Q.str_votes_change_schleicher_dnef).toFixed(1);
    Q.previous_schleicher_dnef_last_election_votes = Q.schleicher_dnef_votes;

    if (Q.right_dnef) {
        Q.right_dnef_r = Q.right_dnef_votes*(Q.dnef_r / Q.dnef_votes);
        Q.schleicher_dnef_r -= Q.right_dnef_r;

        Q.str_votes_change_right_dnef = Q.right_dnef_votes - Q.previous_right_dnef_last_election_votes;
        var sign2 = Q.str_votes_change_right_dnef > 0 ?
            '<img src="img/arrowup.png"> ' :
            Q.str_votes_change_right_dnef < 0 ?
            '<img src="img/arrowdown.png"> ' :
            '<img src="img/steady.png"> ';
        Q.str_votes_change_right_dnef = sign2 + Math.abs(Q.str_votes_change_right_dnef).toFixed(1);
        Q.previous_right_dnef_last_election_votes = Q.right_dnef_votes;

        Q.str_votes_change_schleicher_dnef = Q.schleicher_dnef_votes - Q.previous_schleicher_dnef_last_election_votes;
        var sign2 = Q.str_votes_change_schleicher_dnef > 0 ?
            '<img src="img/arrowup.png"> ' :
            Q.str_votes_change_schleicher_dnef < 0 ?
            '<img src="img/arrowdown.png"> ' :
            '<img src="img/steady.png"> ';
        Q.str_votes_change_schleicher_dnef = sign2 + Math.abs(Q.str_votes_change_schleicher_dnef).toFixed(1);
        Q.previous_schleicher_dnef_last_election_votes = Q.schleicher_dnef_votes;

        // reichstag share

        Q.str_change_right_dnef = Q.right_dnef_r - Q.old_right_dnef_r;
        var sign2 = Q.str_change_right_dnef > 0 ?
            '<img src="img/arrowup.png"> ' :
            Q.str_change_right_dnef < 0 ?
            '<img src="img/arrowdown.png"> ' :
            '<img src="img/steady.png"> ';
        Q.str_change_right_dnef = sign2 + Math.abs(Q.str_change_right_dnef).toFixed(1);
        Q.old_right_dnef_r = Q.right_dnef_r;

        Q.str_change_schleicher_dnef = Q.schleicher_dnef_r - Q.old_schleicher_dnef_r;
        var sign2 = Q.str_change_schleicher_dnef > 0 ?
            '<img src="img/arrowup.png"> ' :
            Q.str_change_schleicher_dnef < 0 ?
            '<img src="img/arrowdown.png"> ' :
            '<img src="img/steady.png"> ';
        Q.str_change_schleicher_dnef = sign2 + Math.abs(Q.str_change_schleicher_dnef).toFixed(1);
        Q.old_schleicher_dnef_r = Q.schleicher_dnef_r;
        Q.true_dnef_r = Q.dnef_r - Q.right_dnef_r;
        Q.true_dnef_r = Math.round(Q.dnef_r * 10) / 10;
        Q.right_dnef_r = Math.round(Q.right_dnef_r * 10) / 10;
    } else if (Q.left_dnef) {
        Q.left_dnef_r = Q.left_dnef_votes*(Q.dnef_r / Q.dnef_votes);
        Q.schleicher_dnef_r -= Q.left_dnef_r;

        Q.str_votes_change_left_dnef = Q.left_dnef_votes - Q.previous_left_dnef_last_election_votes;
        var sign2 = Q.str_votes_change_left_dnef > 0 ?
            '<img src="img/arrowup.png"> ' :
            Q.str_votes_change_left_dnef < 0 ?
            '<img src="img/arrowdown.png"> ' :
            '<img src="img/steady.png"> ';
        Q.str_votes_change_left_dnef = sign2 + Math.abs(Q.str_votes_change_left_dnef).toFixed(1);
        Q.previous_left_dnef_last_election_votes = Q.left_dnef_votes;

        Q.str_votes_change_schleicher_dnef = Q.schleicher_dnef_votes - Q.previous_schleicher_dnef_last_election_votes;
        var sign2 = Q.str_votes_change_schleicher_dnef > 0 ?
            '<img src="img/arrowup.png"> ' :
            Q.str_votes_change_schleicher_dnef < 0 ?
            '<img src="img/arrowdown.png"> ' :
            '<img src="img/steady.png"> ';
        Q.str_votes_change_schleicher_dnef = sign2 + Math.abs(Q.str_votes_change_schleicher_dnef).toFixed(1);
        Q.previous_schleicher_dnef_last_election_votes = Q.schleicher_dnef_votes;

        // reichstag share

        Q.str_change_left_dnef = Q.left_dnef_r - Q.old_left_dnef_r;
        var sign2 = Q.str_change_left_dnef > 0 ?
            '<img src="img/arrowup.png"> ' :
            Q.str_change_left_dnef < 0 ?
            '<img src="img/arrowdown.png"> ' :
            '<img src="img/steady.png"> ';
        Q.str_change_left_dnef = sign2 + Math.abs(Q.str_change_left_dnef).toFixed(1);
        Q.old_left_dnef_r = Q.left_dnef_r;

        Q.str_change_schleicher_dnef = Q.schleicher_dnef_r - Q.old_schleicher_dnef_r;
        var sign2 = Q.str_change_schleicher_dnef > 0 ?
            '<img src="img/arrowup.png"> ' :
            Q.str_change_schleicher_dnef < 0 ?
            '<img src="img/arrowdown.png"> ' :
            '<img src="img/steady.png"> ';
        Q.str_change_schleicher_dnef = sign2 + Math.abs(Q.str_change_schleicher_dnef).toFixed(1);
        Q.old_schleicher_dnef_r = Q.schleicher_dnef_r;
        Q.true_dnef_r = Q.dnef_r - Q.left_dnef_r;
        Q.true_dnef_r = Math.round(Q.dnef_r * 10) / 10;
        Q.left_dnef_r = Math.round(Q.left_dnef_r * 10) / 10;
    }
    Q.schleicher_dnef_r = Math.round(Q.schleicher_dnef_r * 10) / 10;
}

if ((Q.time - Q.marxist_malus_time >= 10 || !Q.marxist_malus_time) && (Q.left_strength >= Q.reformist_strength + Q.labor_strength)) {
    if (Q.spd_votes >= 50) {
        Q.z_relation -= 12;
        Q.ddp_relation -= 12;
        Q.lvp_relation -= 12;
        Q.dvp_relation -= 12;
        Q.lvp_right += 6;
        Q.dvp_right += 6;
        Q.ddp_right += 5;
        Q.ddp_cohesion -= 4;
    } else if (Q.spd_votes >= 45) {
        Q.z_relation -= 9;
        Q.ddp_relation -= 9;
        Q.lvp_relation -= 9;
        Q.dvp_relation -= 9;
        Q.lvp_right += 4;
        Q.dvp_right += 4;
        Q.ddp_right += 3;
        Q.ddp_cohesion -= 3;
    } else if (Q.spd_votes >= 40) {
        Q.z_relation -= 6;
        Q.ddp_relation -= 6;
        Q.lvp_relation -= 6;
        Q.dvp_relation -= 6;
        Q.lvp_right += 3;
        Q.dvp_right += 3;
        Q.ddp_right += 2;
        Q.ddp_cohesion -= 2;
    } else if (Q.spd_votes >= 35) {
        Q.z_relation -= 4;
        Q.ddp_relation -= 4;
        Q.lvp_relation -= 4;
        Q.dvp_relation -= 4;
        Q.lvp_right += 2;
        Q.dvp_right += 2;
        Q.ddp_right += 1;
        Q.ddp_cohesion -= 1;
    }
    Q.marxist_malus_time = Q.time;
}

Q.last_election_time = Q.time;

if (Q.election_boycott && Q.boycott_effect) {
    Q.workers_schleicher_bonus -= 1;
    Q.republicans_schleicher_bonus -= 1;
    Q.industrialists_schleicher_bonus -= 0.5;
    Q.nationalists_schleicher_bonus -= 0.5;
    if (Q.boycott_effect >= 1.05) {
        Q.workers_schleicher_bonus -= 1;
        Q.republicans_schleicher_bonus -= 1;
        Q.industrialists_schleicher_bonus -= 0.5;
        Q.nationalists_schleicher_bonus -= 0.5;
    }
    if (Q.boycott_effect >= 1.1) {
        Q.workers_schleicher_bonus -= 1;
        Q.republicans_schleicher_bonus -= 1;
        Q.industrialists_schleicher_bonus -= 0.5;
        Q.nationalists_schleicher_bonus -= 0.5;
    }
}

// The largest party can only be the NSDAP or the SPD.
Q.largest_party = 'SPD';
if (Q.nsdap_r >= Q.spd_r && Q.nsdap_r >= Q.kpd_r && Q.nsdap_r >= Q.z_r) {
    Q.largest_party = 'NSDAP';
}

if (Q.kpd_r >= Q.spd_r && Q.kpd_r >= Q.nsdap_r && Q.kpd_r >= Q.z_r) {
    Q.largest_party = 'KPD';
}

if (Q.z_r >= Q.spd_r && Q.z_r >= Q.nsdap_r && Q.z_r >= Q.kpd_r) {
    Q.largest_party = 'Z';
}

// coalitions
if (Q.lvp_formed) {
    Q.weimar_coalition = parseFloat((Q.spd_r + Q.lvp_r + Q.z_r - Q.bvp_r).toFixed(1));
} else {
    Q.weimar_coalition = parseFloat((Q.spd_r + Q.ddp_r + Q.z_r - Q.bvp_r).toFixed(1));
}

if (Q.lvp_formed) {
    Q.social_liberal_coalition = parseFloat((Q.spd_r + Q.lvp_r).toFixed(1));
} else {
    Q.social_liberal_coalition = parseFloat((Q.spd_r + Q.ddp_r).toFixed(1));
}

Q.social_catholic_coalition = parseFloat((Q.spd_r + Q.z_r - Q.bvp_r).toFixed(1));

if (Q.lvp_formed) {
    Q.grand_coalition = parseFloat((Q.spd_r + Q.lvp_r + Q.z_r).toFixed(1));
} else {
    Q.grand_coalition = parseFloat((Q.spd_r + Q.ddp_r + Q.z_r + Q.dvp_r).toFixed(1));
}

if (Q.kvp_formed && Q.lvp_formed) {
    Q.bourgeois_coalition = parseFloat((Q.z_r + Q.lvp_r + Q.other_r + Q.kvp_r).toFixed(1));
} else if (Q.kvp_formed && !Q.lvp_formed) {
    Q.bourgeois_coalition = parseFloat((Q.ddp_r + Q.z_r + Q.dvp_r + Q.other_r + Q.kvp_r).toFixed(1));
} else if (Q.lvp_formed && !Q.kvp_formed) {
    Q.bourgeois_coalition = parseFloat((Q.z_r + Q.lvp_r + Q.other_r).toFixed(1));
} else {
    Q.bourgeois_coalition = parseFloat((Q.ddp_r + Q.z_r + Q.dvp_r + Q.other_r).toFixed(1));
}

if (Q.kvp_formed && Q.lvp_formed) {
    Q.center_right_coalition = parseFloat((Q.z_r + Q.lvp_r + Q.other_r + Q.dnvp_r + Q.kvp_r).toFixed(1));
} else if (Q.kvp_formed && !Q.lvp_formed) {
    Q.center_right_coalition = parseFloat((Q.z_r + Q.ddp_r + Q.dvp_r + Q.other_r + Q.dnvp_r + Q.kvp_r).toFixed(1));
} else if (!Q.kvp_formed && Q.lvp_formed) {
    Q.center_right_coalition = parseFloat((Q.z_r + Q.lvp_r + Q.other_r + Q.dnvp_r).toFixed(1));
} else {
    Q.center_right_coalition = parseFloat((Q.z_r + Q.ddp_r + Q.dvp_r + Q.other_r + Q.dnvp_r).toFixed(1));
}

if (Q.lvp_formed) {
    Q.right_coalition = parseFloat((Q.z_r + Q.lvp_r + Q.other_r + Q.dnvp_r).toFixed(1));
} else {
    Q.right_coalition = parseFloat((Q.z_r + Q.dvp_r + Q.other_r + Q.dnvp_r).toFixed(1));
}

if (Q.dnvp_ideology === "Moderate") {
    Q.far_right_coalition = parseFloat((Q.dnf_r + Q.nsdap_r).toFixed(1));
} else {
    Q.far_right_coalition = parseFloat((Q.dnvp_r + Q.nsdap_r).toFixed(1));
}

if (Q.dvp_leader == "Dingeldey" && Q.dvp_ideology == "Right" && Q.dvp_right - Q.dvp_left >= 15 || Q.hugenberg_dvp) {
    Q.far_right_coalition = parseFloat((Q.far_right_coalition + Q.dvp_r).toFixed(1));
}

Q.left_coalition = parseFloat((Q.spd_r + Q.kpd_r + Q.sapd_r).toFixed(1));

Q.socialist_front = parseFloat((Q.spd_r + Q.sapd_r).toFixed(1));

if (Q.lvp_formed) {
    Q.popular_front_coalition = parseFloat((Q.spd_r + Q.kpd_r + Q.z_r - Q.bvp_r + Q.sapd_r).toFixed(1));
} else if (Q.liberal_parliament == 0 && Q.bourgeois_parliament_ddp == 0) {
    Q.popular_front_coalition = parseFloat((Q.spd_r + Q.kpd_r + Q.z_r + Q.ddp_r - Q.bvp_r + Q.sapd_r).toFixed(1));
} else if (Q.liberal_parliament == 1 || Q.bourgeois_parliament_ddp == 1) {
    Q.popular_front_coalition = parseFloat((Q.spd_r + Q.kpd_r + Q.z_r - Q.bvp_r + Q.sapd_r).toFixed(1));
}

if (Q.dnvp_ideology === "Moderate") {
    Q.anti_democratic_coalition = parseFloat((Q.kpd_r + Q.nsdap_r + Q.dnf_r).toFixed(1));
} else {
    Q.anti_democratic_coalition = parseFloat((Q.kpd_r + Q.nsdap_r + Q.dnvp_r).toFixed(1));
}

if (Q.lvp_formed) {
    Q.neo_weimar_coalition = parseFloat((Q.spd_r + Q.lvp_r + Q.z_r + Q.other_r).toFixed(1));
} else {
    Q.neo_weimar_coalition = parseFloat((Q.spd_r + Q.ddp_r + Q.z_r + Q.dvp_r + Q.other_r).toFixed(1));
}

if (Q.kvp_formed && Q.lvp_formed) {
    Q.cordon_sanitaire = parseFloat((Q.spd_r + Q.lvp_r + Q.z_r + Q.other_r + Q.kvp_r).toFixed(1));
} else if (Q.kvp_formed && !Q.lvp_formed) {
    Q.cordon_sanitaire = parseFloat((Q.spd_r + Q.ddp_r + Q.z_r + Q.dvp_r + Q.other_r + Q.dnvp_r + Q.kvp_r).toFixed(1));
} else if (Q.lvp_formed && !Q.kvp_formed) {
    Q.cordon_sanitaire = parseFloat((Q.spd_r + Q.z_r + Q.lvp_r + Q.other_r + Q.dnvp_r).toFixed(1));
} else {
    Q.cordon_sanitaire = parseFloat((Q.spd_r + Q.z_r + Q.ddp_r + Q.dvp_r + Q.other_r + Q.dnvp_r).toFixed(1));
}

Q.hitler_right_coalition = parseFloat((Q.z_r + Q.nsdap_r).toFixed(1));

Q.goerdeler_right_coalition = parseFloat((Q.z_r + Q.dvp_r + Q.lvp_r + Q.other_r + Q.kvp_r + Q.dnvp_r + Q.dnf_r).toFixed(1));

if (Q.lvp_formed) {
    Q.progressive_coalition = parseFloat((Q.spd_r + Q.kpd_r + (Q.lvp_r / 3) + Q.sapd_r).toFixed(1));
} else {
    Q.progressive_coalition = parseFloat((Q.spd_r + Q.kpd_r + Q.ddp_r + Q.sapd_r).toFixed(1));
}

if (Q.dnef_formed) {
    Q.schleicher_right_coalition = parseFloat((Q.dnef_r + Q.lvp_r + Q.dvp_r + Q.ddp_r + Q.z_r + Q.other_r + Q.kvp_r + Q.dnvp_r + Q.dnf_r + Q.dsu_r).toFixed(1));
    Q.schleicher_left_coalition = parseFloat((Q.dnef_r + Q.spd_r + Q.lvp_r + Q.ddp_r + Q.z_r).toFixed(1));
}

if (Q.kpd_relation >= 30 && Q.sapd_formed == 1 && Q.weimar_coalition <= 50) {
    Q.weimar_coalition += Q.sapd_r;
    Q.sapd_weimar = 1;
} else {
    Q.sapd_weimar = 0;
}

Q.leverage = Q.spd_r;
if (Q.right_coalition >= 50 && (Q.dnvp_ideology == "Moderate" || Q.dnvp_westarp) || Q.center_right_coalition >= 50 && Q.dnvp_ideology == "Moderate") Q.leverage -= 5;
Q.support_kpd_grand = 0;
Q.support_kpd_weimar = 0;

Q.bruning_coalition = Q.neo_weimar_coalition;
if (Q.kvp_formed) Q.bruning_coalition += Q.kvp_r;
if (Q.dnvp_ideology == "Moderate" && !Q.dnvp_defect) Q.bruning_coalition = Q.cordon_sanitaire;
Q.bruning_coalition_loss = 0;
if (Q.cnblp_defect) Q.bruning_coalition_loss += Q.cnblp_r;
if (Q.wp_defect) Q.bruning_coalition_loss += Q.wp_r;
if (Q.dvp_defect) Q.bruning_coalition_loss += (Q.dvp_r*0.7);
if (Q.lvp_defect) Q.bruning_coalition_loss += (Q.lvp_r*0.4);
Q.bruning_coalition = Q.bruning_coalition - Q.bruning_coalition_loss;
Q.dnvp_angry = 0;
if (Q.year >= 1932) {
    Q.elections_1932 += 1;
    Q.nazi_funds -= 1;
}
Q.grand_coalition_failed = 0;
// Reset government and ministers... Based on Brüning's 1930 govt
Q.coalition_dissent = 0;
Q.kpd_coalition_dissent = 0;
if (!Q.spd_in_government) {
    Q.hindenburg_angry = 0;
    Q.hindenburg_angry_old = 0;
}
if (Q.spd_in_government) Q.hindenburg_angry_old = Q.hindenburg_angry;
Q.spd_in_government = 0;
Q.in_weimar_coalition = 0;
Q.in_grand_coalition = 0;
Q.in_wholesome_coalition = 0;
Q.in_social_catholic_coalition = 0;
Q.in_social_catholic_coalition = 0;
Q.in_left_front = 0;
Q.sapd_toleration = 0;
Q.in_popular_front = 0;
Q.in_emergency_government = 0;
Q.in_minority_government = 0;
Q.in_unity_government = 0;
Q.spd_toleration = 0;
Q.spd_toleration_right = 0;
Q.spd_caretaker = 0;
if (Q.lvp_formed) Q.foreign_minister_party = 'LVP'; 
if (!Q.lvp_formed) Q.foreign_minister_party = 'DVP';
Q.interior_minister_party = 'Z';
Q.justice_minister_party = 'I';
Q.labor_minister_party = 'Z';
Q.reichswehr_minister_party = 'I';
if (Q.lvp_formed) Q.economic_minister_party = 'LVP'; 
if (!Q.lvp_formed) Q.economic_minister_party = Q.ddp_name;
if (Q.lvp_formed) Q.finance_minister_party = 'LVP'; 
if (!Q.lvp_formed) Q.finance_minister_party = 'DVP';
Q.agriculture_minister_party = 'Z';

Q.ddp_in_popular_front = 0;

// reset KPD goals
Q.kpd_demands_federal = 0;
Q.kpd_goals_seen = 0;
Q.kpd_ultimatum_seen = 0;
Q.welfare_goal = 0;
Q.agriculture_goal = 0;
Q.economy_goal = 0;
Q.finance_goal = 0;
Q.labor_goal = 0;
Q.foreign_goal = 0;
Q.interior_goal = 0;
Q.reichswehr_goal = 0;

Q.welfare_goal_completed = 0;
Q.agriculture_goal_completed = 0;
Q.economy_goal_completed = 0;
Q.finance_goal_completed = 0;
Q.labor_goal_completed = 0;
Q.foreign_goal_completed = 0;
Q.interior_goal_completed = 0;
Q.reichswehr_goal_completed = 0;

Q.cvp_ministers_accepted = 0;
Q.cvp_economy_accepted = 0;
Q.cvp_chancellor_accepted = 0;
Q.cvp_reichsbanner_accepted = 0;
Q.cvp_women_accepted = 0;

Q.strike_term_seen = 0;
Q.grand_coalition_collapsed = 0;

// understanding the enemy
if (Q.nsdap_r >= 15) {
    Q.understanding_enemy_timer = 2;
}

if (Q.dstp_formed && !Q.dstp_collapse_seen) {
    Q.dstp_election = 1;
}

if (Q.ddp_r < 3.6 && !Q.lvp_formed && !Q.liberal_parliament && !Q.bourgeois_parliament_ddp && Q.ddp_r) {
    Q.ddp_factionless = 1
}

if (Q.hitler_right_coalition >= 50 && Q.rubicon) {
    if (!Q.hitler_right_coalition_time) Q.hitler_right_coalition_time = Q.time;
}

if (Q.change_nsdap_votes < -2 && Q.rubicon) {
    if (!Q.nsdap_decline_time) Q.nsdap_decline_time = Q.time;
}

if ((Q.spd_votes < 20 && Q.schleicher_spd_r >= 3) || (Q.spd_votes < 25 && Q.spd_votes > 20 && Q.schleicher_spd_r >= 4)) {
    Q.schleicher_r_spd -= 2;
    if (Q.schleicher_spd_r >= 6) Q.schleicher_r_spd -= 2;
    Q.schleicher_spd_support -= 4;
    Q.schleicher_spd_influence -= 1;
    Q.center_dissent += 5;
    Q.left_dissent += 5;
    Q.neorevisionist_dissent += 5;
}

if (Q.dnef_formed) Q.hindenburg_schleicher_r += Math.round((Q.dnef_votes / 10) * 10) / 10;

if (Q.left_coalition >= 50) {
    Q.kpd_relation += 10;
    Q.left_strength += 10;
    Q.communist_coalition += 1;
    Q.coup_progress += 1;
}

var lippe_adjustment_factors = {
    spd: 1.32,
    sapd: 0.4,
    kpd: 0.91,
    ddp: 0.62,
    lvp: 1.15,
    z: 0.17,
    dvp: 2.0,
    dnvp: 1.19,
    nsdap: 1.05,
    other: 1.7,
    kvp: 1.35,
    dnf: 0.5
};

Q.old_spd_lippe_elections_vote = Q.spd_votes * lippe_adjustment_factors.spd;
Q.old_sapd_lippe_elections_vote = Q.sapd_votes * lippe_adjustment_factors.sapd;
Q.old_kpd_lippe_elections_vote = Q.kpd_votes * lippe_adjustment_factors.kpd;
Q.old_ddp_lippe_elections_vote = Q.ddp_votes * lippe_adjustment_factors.ddp;
Q.old_lvp_lippe_elections_vote = Q.lvp_votes * lippe_adjustment_factors.lvp;
Q.old_z_lippe_elections_vote = Q.z_votes * lippe_adjustment_factors.z;
Q.old_dvp_lippe_elections_vote = Q.dvp_votes * lippe_adjustment_factors.dvp;
Q.old_dnvp_lippe_elections_vote = Q.dnvp_votes * lippe_adjustment_factors.dnvp;
Q.old_nsdap_lippe_elections_vote = Q.nsdap_votes * lippe_adjustment_factors.nsdap;
Q.old_other_lippe_elections_vote = Q.other_votes * lippe_adjustment_factors.other;
Q.old_kvp_lippe_elections_vote = Q.kvp_votes * lippe_adjustment_factors.kvp;
Q.old_dnf_lippe_elections_vote = Q.dnf_votes * lippe_adjustment_factors.dnf;

if (Q.year < 1929) {
    Q.reichstag_size = 4.91;
} else if (Q.year < 1930) {
    Q.reichstag_size = 5.2;
} else if (Q.year < 1931) {
    Q.reichstag_size = 5.77;
    if (Q.unemployed < 8) Q.reichstag_size -= 0.1;
} else if (Q.year < 1932) {
    Q.reichstag_size = 5.95;
    if (Q.unemployed < 20) Q.reichstag_size -= 0.1;
    if (Q.unemployed < 25) Q.reichstag_size -= 0.1;
    if (Q.unemployed < 30) Q.reichstag_size -= 0.1;
} else if (Q.year < 1933) {
    Q.reichstag_size = 6.08;
    if (Q.unemployed < 20) Q.reichstag_size -= 0.1;
    if (Q.unemployed < 25) Q.reichstag_size -= 0.1;
    if (Q.unemployed < 30) Q.reichstag_size -= 0.1;
} else if (Q.year < 1934) {
    Q.reichstag_size = 5.95;
    if (Q.unemployed < 20) Q.reichstag_size -= 0.1;
    if (Q.unemployed < 25) Q.reichstag_size -= 0.1;
    if (Q.unemployed < 30) Q.reichstag_size -= 0.1;
} else {
    Q.reichstag_size = 5.5;
    if (Q.unemployed < 20) Q.reichstag_size -= 0.1;
    if (Q.unemployed < 25) Q.reichstag_size -= 0.1;
    if (Q.unemployed < 30) Q.reichstag_size -= 0.1;
}

var election_result = {'date': new Date(Q.year, Q.month - 1)};
for (var party of Q.parties_graph) {
    election_result[party] = Q[party + '_r'];
}
Q.election_records.push(election_result);
!}
on-departure: nazi_urgency = 1 if (nazi_urgency == 0 and nsdap_r >= 15)
on-display: {!
const data = [];

if (Q.kpd_r) {
    data.push({
        "id": "kpd",
        "legend": "KPD",
        "name": "KPD",
        "seats": Math.round(Q.kpd_r * Q.reichstag_size),
    });
}

if (Q.sapd_r && Q.sapd_formed) {
    data.push({
        "id": "sapd",
        "legend": "SAPD",
        "name": "SAPD",
        "seats": Math.round(Q.sapd_r * Q.reichstag_size),
    });
}

if (Q.spd_r && !Q.rdp_r) {
    data.push({
        "id": "spd",
        "legend": "SPD",
        "name": "SPD",
        "seats": Math.round(Q.spd_r * Q.reichstag_size),
    });
} else if (Q.spd_r && Q.rdp_r) {
    data.push({
        "id": "spd",
        "legend": "SPD",
        "name": "SPD",
        "seats": Math.round((Q.spd_r - Q.rdp_r) * Q.reichstag_size),
    });
}

if (Q.rdp_r) {
    data.push({
        "id": "rdp",
        "legend": "RDP",
        "name": "RDP",
        "seats": Math.round(Q.rdp_r * Q.reichstag_size),
    });
}

if (Q.dnvp_r && Q.dnvp_wholesome) {
    data.push({
        "id": "dnvp_wholesome",
        "legend": "DNVP",
        "name": "DNVP",
        "seats": Math.round(Q.dnvp_r * Q.reichstag_size),
    });
}

if (Q.ddp_r && !Q.lvp_formed) {
    data.push({
        "id": "ddp",
        "legend": Q.ddp_name,
        "name": Q.ddp_name,
        "seats": Math.round(Q.ddp_r * Q.reichstag_size),
    });
}

if (Q.lvp_r && Q.lvp_formed) {
    data.push({
        "id": "lvp",
        "legend": "LVP",
        "name": "LVP",
        "seats": Math.round(Q.lvp_r * Q.reichstag_size),
    });
}


if (Q.z_minus_bvp_r) {
    data.push({
        "id": "z",
        "legend": "Center",
        "name": "Center",
        "seats": Math.round(Q.z_minus_bvp_r * Q.reichstag_size),
    });
}

if (Q.bvp_r) {
    data.push({
        "id": "bvp",
        "legend": "BVP",
        "name": "BVP",
        "seats": Math.round(Q.bvp_r * Q.reichstag_size),
    });
}

if (Q.dvp_r && !Q.lvp_formed && Q.dvp_exist) {
    data.push({
        "id": "dvp",
        "legend": "DVP",
        "name": "DVP",
        "seats": Math.round(Q.dvp_r * Q.reichstag_size),
    });
}

if (Q.left_dnef_r && Q.left_dnef) {
    data.push({
        "id": "left_dnef",
        "legend": "Left_DNEF",
        "name": "Left_DNEF",
        "seats": Math.round(Q.left_dnef_r * Q.reichstag_size),
    });
}

if (Q.true_dnef_r && Q.dnef_formed && !Q.right_dnef && !Q.left_dnef) {
    data.push({
        "id": "dnef",
        "legend": "DNEF",
        "name": "DNEF",
        "seats": Math.round(Q.true_dnef_r * Q.reichstag_size),
    });
}

if (Q.true_dnef_r && Q.dnef_formed && Q.right_dnef && !Q.left_dnef) {
    data.push({
        "id": "dnef",
        "legend": "DNEF",
        "name": "DNEF",
        "seats": Math.round((Q.true_dnef_r - Q.right_dnef_r) * Q.reichstag_size),
    });
}

if (Q.true_dnef_r && Q.dnef_formed && !Q.right_dnef && Q.left_dnef) {
    data.push({
        "id": "dnef",
        "legend": "DNEF",
        "name": "DNEF",
        "seats": Math.round((Q.true_dnef_r - Q.left_dnef_r) * Q.reichstag_size),
    });
}

if (Q.right_dnef_r && Q.right_dnef) {
    data.push({
        "id": "right_dnef",
        "legend": "Right_DNEF",
        "name": "Right_DNEF",
        "seats": Math.round(Q.right_dnef_r * Q.reichstag_size),
    });
}

if (Q.wp_r) {
    data.push({
        "id": "wp",
        "legend": "WP",
        "name": "WP",
        "seats": Math.round(Q.wp_r * Q.reichstag_size),
    });
}

if (Q.cnblp_r) {
    data.push({
        "id": "farm3",
        "legend": "CNBLP",
        "name": "CNBLP",
        "seats": Math.round(Q.cnblp_r * Q.reichstag_size),
    });
}

if (Q.csvd_r && Q.csvd_formed) {
    data.push({
        "id": "csvd",
        "legend": "CSVD",
        "name": "CSVD",
        "seats": Math.round(Q.csvd_r * Q.reichstag_size),
    });
}

if (Q.other_r) {
    data.push({
        "id": "other",
        "legend": "Other",
        "name": "Other",
        "seats": Math.round(Q.true_other_r * Q.reichstag_size),
    });
}

if (Q.true_aspd_r && (Q.aspd_other || Q.aspd_kvp)) {
    data.push({
        "id": "aspd",
        "legend": "ASPD",
        "name": "ASPD",
        "seats": Math.round(Q.true_aspd_r * Q.reichstag_size),
    });
}

if (Q.kvp_formed && Q.kvp_r && !Q.aspd_kvp && !Q.dnvp_dvp_formed) {
    data.push({
        "id": "kvp",
        "legend": "KVP",
        "name": "KVP",
        "seats": Math.round(Q.kvp_r * Q.reichstag_size),
    });
} else if (Q.kvp_formed && Q.kvp_r && Q.aspd_kvp && !Q.dnvp_dvp_formed) {
    data.push({
        "id": "kvp",
        "legend": "KVP",
        "name": "KVP",
        "seats": Math.round((Q.kvp_r - Q.true_aspd_r) * Q.reichstag_size),
    });
}

if (Q.dnvp_dvp_formed) {
    data.push({
        "id": "fkp",
        "legend": "FKP",
        "name": "FKP",
        "seats": Math.round(Q.kvp_r * Q.reichstag_size),
    });
}

if (Q.dnvp_r && !Q.dnvp_wholesome) {
    data.push({
        "id": "dnvp",
        "legend": "DNVP",
        "name": "DNVP",
        "seats": Math.round(Q.dnvp_r * Q.reichstag_size),
    });
}

if (Q.dnf_formed && Q.dnf_r) {
    data.push({
        "id": "dnf",
        "legend": "DNF",
        "name": "DNF",
        "seats": Math.round(Q.dnf_r * Q.reichstag_size),
    });
}

if (Q.dsu_exist && Q.dsu_r) {
    data.push({
        "id": "dsu",
        "legend": "DSU",
        "name": "DSU",
        "seats": Math.round(Q.dsu_r * Q.reichstag_size),
    });
}

if (Q.nsdap_split && Q.nsdap_hitler_r) {
    data.push({
        "id": "nsdap",
        "legend": "NSDAP",
        "name": "NSDAP",
        "seats": Math.round(Q.nsdap_hitler_r * Q.reichstag_size),
    });
}

if (!Q.nsdap_split && Q.nsdap_r) {
    data.push({
        "id": "nsdap",
        "legend": "NSDAP",
        "name": "NSDAP",
        "seats": Math.round(Q.nsdap_r * Q.reichstag_size),
    });
}

if (Q.nvf_exist && Q.nvf_r) {
    data.push({
        "id": "nvf",
        "legend": "NVF",
        "name": "NVF",
        "seats": Math.round(Q.nvf_r * Q.reichstag_size),
    });
}

if (window && d3) {
    var width = 500;
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("reichstag").style.height = screenWidth/2 + "px";
    }
    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#reichstag").datum(data).call(parliament);

    var lines = d3.linegraph(false, false,
            Q.parties_graph,
            {'spd': '#E3000F', 'kpd': '#700000', 'ddp': '#D3C24D', 'z': '#000', 'dvp': '#D5AC27', 'dnvp': '#3E88B3', 'nsdap': '#7A3C00', 'other': '#a0a0a0', 'sapd': '#9B0000', 'dnf': '#003755', 'kvp': '#0087DC', 'lvp': '#FFCC00', 'dnef': '#BFC8CC', 'fkp': '#00C0FF'},
            {'spd': 'SPD', 'kpd': 'KPD', 'ddp': Q.ddp_name, 'z': Q.z_party_name + ' + BVP', 'dvp': 'DVP', 'dnvp': 'DNVP', 'nsdap': 'NSDAP', 'other': 'Others', 'sapd': 'SAPD', 'dnf': 'DNF', 'kvp': 'KVP', 'lvp': 'LVP', 'dnef': 'DNEF', 'fkp': 'FKP'});
    lines.width(width).height(400);
    //var svg = lines(Q.election_records);
    d3.select("#election_history").datum(Q.election_records).call(lines);
    //document.getElementById('election_history').innerHTML = svg.outerHTML;

    // party support records should not have so many ticks
    if (!Q.historical_mode) {
        var lines_2 = d3.linegraph(true, true,
            Q.parties_graph,
            {'spd': '#E3000F', 'kpd': '#700000', 'ddp': '#D3C24D', 'z': '#000', 'dvp': '#D5AC27', 'dnvp': '#3E88B3', 'nsdap': '#7A3C00', 'other': '#a0a0a0', 'sapd': '#9B0000', 'dnf': '#003755', 'kvp': '#0087DC', 'lvp': '#FFCC00', 'dnef': '#BFC8CC', 'fkp': '#00C0FF'},
            {'spd': 'SPD', 'kpd': 'KPD', 'ddp': Q.ddp_name, 'z': Q.z_party_name + ' + BVP', 'dvp': 'DVP', 'dnvp': 'DNVP', 'nsdap': 'NSDAP', 'other': 'Others', 'sapd': 'SAPD', 'dnf': 'DNF', 'kvp': 'KVP', 'lvp': 'LVP', 'dnef': 'DNEF', 'fkp': 'FKP'});
        lines_2.width(width).height(400);
        d3.select("#party_support_history").datum(Q.party_support_records).call(lines_2);
    }
}
!}

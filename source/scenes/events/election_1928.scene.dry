[? if dnef_formed and right_dnef: {!<tr><td><div class="box2" style='background-color:#5F7278'> </div> !} DNEF-VLB: {!</td><td>!} [+ right_dnef_votes +]% {!</td><td>!} [+ str_votes_change_right_dnef +] {!</td><td>!} [+ right_dnef_r +]% {!</td><td>!} [+ str_change_right_dnef +] {!</td></tr>!} ?]


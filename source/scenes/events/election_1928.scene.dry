    Q.old_nsdap_hitler_r = Q.nsdap_hitler_r;
}

if (Q.rdp_list) {
    Q.rdp_votes = Q.new_middle_spd_normalized;
    Q.rdp_votes *= (Q.spd_votes / 100);
    if (Q.pro_republic >= 15) Q.rdp_votes *= (Q.pro_republic / 100);
    if (Q.pro_republic < 15) Q.rdp_votes *= 0.15;
    if (Q.rdp_votes < 0.5) Q.rdp_votes = 0.5;
    Q.rdp_r = Q.rdp_votes*(Q.spd_r / Q.spd_votes);

    Q.rdp_votes = Math.round(Q.rdp_votes * 10) / 10;

    Q.spd_votes -= Q.rdp_votes;

    // vote share
    Q.str_votes_change_rdp = Q.rdp_votes - Q.previous_rdp_last_election_votes;
    var sign2 = Q.str_votes_change_rdp > 0 ?
        '<img src="img/arrowup.png"> ' :
        Q.str_votes_change_rdp < 0 ?

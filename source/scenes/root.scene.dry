// use decimals for reichstag seats
// TODO: not yet implemented
Q.use_decimals = 0;

// party resources
Q.resources = 2;
// party dues
Q.dues = 2;

// the state of the party
// overall dissent reduces every increase in party support.
Q.dissent = 0.05;
Q.dissent_percent = 5;

// factions
Q.factions = ['sammlung', 'linksliberale', 'pazifisten', 'nationalliberale', 'republikschutzer'];
// should this be normalized to 100%?
Q.nationalliberale_strength = 20;
Q.sammlung_strength = 30;
Q.linksliberale_strength = 40;
Q.pazifisten_strength = 10;
